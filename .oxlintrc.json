{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "import",
    "unicorn"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "ignorePatterns": [
    "node_modules",
    "dist",
    "coverage"
  ],
  "rules": {
    "unicorn/require-post-message-target-origin": "off"
  }
}