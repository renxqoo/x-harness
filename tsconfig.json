{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "types": ["bun"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    "packages/*/src/**/*.ts", "packages/core/*/src/**/*.ts",
    "packages/*/test/**/*.ts", "packages/core/*/test/**/*.ts",
    "packages/*/plugins/**/*.ts", "packages/core/*/plugins/**/*.ts",
    "apps/*/src/**/*.ts",
    "scripts/**/*.ts"
  ]
}
