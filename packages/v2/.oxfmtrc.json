{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "arrowParens": "always",
  "sortImports": false,
  "sortPackageJson": false,
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "coverage/**",
    "**/reviews/**",
    "**/.vitest/**"
  ],
  "associations": [
    {
      "files": ["**/*.case"],
      "language": "typescript"
    }
  ]
}
