import type { Journeys } from "__COMPARISON_TYPES__";
import { readService } from "./read-service";
import { closeResource } from "./close-resource";
import { joinTask } from "./join-task";
import { deliverEvent } from "./deliver-event";
import { replaceProvider } from "./replace-provider";
import { drainReplacement } from "./drain-replacement";

export async function runCordis(): Promise<Journeys> {
  return {
    service: await readService(),
    resource: await closeResource(),
    task: await joinTask(),
    event: await deliverEvent(),
    replacement: await replaceProvider(),
    inFlight: await drainReplacement(),
  };
}
