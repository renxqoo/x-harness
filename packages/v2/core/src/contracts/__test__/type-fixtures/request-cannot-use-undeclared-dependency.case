import { definePlugin } from "__PUBLIC_ENTRY__";
import { greeting, userStore, changed, ok, openConnection } from "__AUTHORING_FIXTURE__";
definePlugin({
  name: "bad",
  provides: { greeting },
  setup(ctx) {
    return ctx.service({
      greeting: {
        async greet(input, call) {
          void call.deps.missing;
          return ok(input.name);
        },
      },
    });
  },
});
