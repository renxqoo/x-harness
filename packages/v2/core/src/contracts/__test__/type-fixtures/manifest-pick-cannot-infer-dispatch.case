import { definePlugin } from "__PUBLIC_ENTRY__";
import type { PluginInvocation } from "__PUBLIC_ENTRY__";
function run(call: Pick<PluginInvocation<{ requires: { chain: typeof chain } }>, "dispatch">) { return call.dispatch("chain", "wrong"); }
definePlugin({ name: "bad", setup(ctx) { return ctx.startTask({ label: "bad", run }); } });
