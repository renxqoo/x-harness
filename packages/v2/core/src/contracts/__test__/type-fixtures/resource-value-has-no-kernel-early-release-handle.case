import { definePlugin } from "__PUBLIC_ENTRY__";
import { greeting, userStore, changed, ok, openConnection } from "__AUTHORING_FIXTURE__";
definePlugin({ name: 'bad', async setup(ctx) { const result = await ctx.resource({ open: (acquire) => openConnection(acquire.signal), close: (connection, cleanup) => connection.close(cleanup.signal) }); if (!result.ok) return result; return result.value.release(); } });
