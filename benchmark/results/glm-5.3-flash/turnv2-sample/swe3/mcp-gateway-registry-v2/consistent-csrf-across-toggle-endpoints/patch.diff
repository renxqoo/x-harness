+++ b/tests/unit/api/test_toggle_csrf_consistency.py
@@ -0,0 +1,230 @@
+"""Route-level CSRF consistency tests for the toggle endpoints.
+
+Issue #891: every user-facing toggle endpoint must enforce CSRF for
+session-cookie (browser) requests while letting bearer-token M2M requests
+(no cookie) through. These tests exercise the REAL verify_csrf_token_flexible
+dependency - they deliberately do NOT override it, unlike most other route
+test fixtures in this suite.
+"""
+
+import logging
+from unittest.mock import AsyncMock, MagicMock, patch
+
+import pytest
+from fastapi import FastAPI
+from fastapi.testclient import TestClient
+
+from registry.api.agent_routes import router as agent_router
+from registry.api.skill_routes import router as skill_router
+from registry.api.virtual_server_routes import router as virtual_server_router
+from registry.auth import csrf as csrf_module
+from registry.auth.dependencies import nginx_proxied_auth
+from tests.fixtures.factories import AgentCardFactory
+
+logger = logging.getLogger(__name__)
+
+# The session value the cookie jar carries in these tests. The cookie name
+# and signing secret are read from the same module state the dependency uses.
+SESSION_VALUE = "toggle-consistency-session"
+COOKIE_NAME = csrf_module.settings.session_cookie_name
+
+ADMIN_CONTEXT = {
+    "username": "admin",
+    "groups": ["mcp-registry-admin"],
+    "scopes": ["mcp-servers-unrestricted/read", "mcp-servers-unrestricted/execute"],
+    "accessible_servers": ["all"],
+    "accessible_services": ["all"],
+    "accessible_agents": ["all"],
+    "ui_permissions": {
+        "list_service": ["all"],
+        "toggle_service": ["all"],
+        "register_service": ["all"],
+        "view_tools": ["all"],
+        "refresh_service": ["all"],
+        "modify_service": ["all"],
+        "list_agents": ["all"],
+        "get_agent": ["all"],
+    },
+    "can_modify_servers": True,
+    "is_admin": True,
+    "auth_method": "keycloak",
+}
+
+
+def _build_app() -> FastAPI:
+    """App with the three dual-credential toggle routers and real CSRF dep."""
+    app = FastAPI()
+    app.include_router(agent_router, prefix="/api")
+    app.include_router(skill_router, prefix="/api")
+    app.include_router(virtual_server_router, prefix="/api")
+    app.dependency_overrides[nginx_proxied_auth] = lambda: ADMIN_CONTEXT
+    return app
+
+
+def _client(app: FastAPI, *, with_cookie: bool) -> TestClient:
+    """Cookie-less client simulates a bearer M2M caller; cookie client a browser."""
+    if with_cookie:
+        return TestClient(app, cookies={COOKIE_NAME: SESSION_VALUE})
+    return TestClient(app)
+
+
+# =============================================================================
+# Fixtures
+# =============================================================================
+
+
+@pytest.fixture
+def test_app():
+    app = _build_app()
+    yield app
+    app.dependency_overrides.clear()
+
+
+@pytest.fixture
+def valid_token():
+    """CSRF token bound to SESSION_VALUE, as /api/auth/csrf-token would return."""
+    return csrf_module.generate_csrf_token(SESSION_VALUE)
+
+
+@pytest.fixture
+def mock_agent_service():
+    with (
+        patch("registry.api.agent_routes.agent_service") as mock,
+        patch("registry.auth.dependencies.user_has_ui_permission_for_service", return_value=True),
+        patch("registry.search.service.faiss_service") as mock_faiss,
+    ):
+        mock.get_agent_info = AsyncMock(return_value=AgentCardFactory())
+        mock.toggle_agent = AsyncMock(return_value=True)
+        mock_faiss.add_or_update_entity = AsyncMock()
+        yield mock
+
+
+@pytest.fixture
+def mock_skill_service():
+    with (
+        patch("registry.api.skill_routes.get_skill_service") as mock_get,
+    ):
+        service = MagicMock()
+        service.get_skill = AsyncMock(return_value=MagicMock(owner="someone-else"))
+        service.toggle_skill = AsyncMock(return_value=True)
+        mock_get.return_value = service
+        yield service
+
+
+@pytest.fixture
+def mock_vs_service():
+    with patch("registry.api.virtual_server_routes.get_virtual_server_service") as mock_get:
+        service = MagicMock()
+        service.toggle_virtual_server = AsyncMock(return_value=True)
+        mock_get.return_value = service
+        yield service
+
+
+# =============================================================================
+# Bearer-token M2M path: no session cookie, no CSRF token -> allowed
+# =============================================================================
+
+
+@pytest.mark.unit
+class TestBearerToggleAllowed:
+    """The reported bug: bearer M2M clients could not enable what they registered."""
+
+    def test_agent_toggle_bearer_allowed(self, test_app, mock_agent_service):
+        response = _client(test_app, with_cookie=False).post(
+            "/api/agents/test-agent/toggle?enabled=true"
+        )
+        assert response.status_code == 200
+        assert response.json()["is_enabled"] is True
+
+    def test_skill_toggle_bearer_allowed(self, test_app, mock_skill_service):
+        response = _client(test_app, with_cookie=False).post(
+            "/api/skills/test-skill/toggle", json={"enabled": True}
+        )
+        assert response.status_code == 200
+        assert response.json()["is_enabled"] is True
+
+    def test_virtual_server_toggle_bearer_allowed(self, test_app, mock_vs_service):
+        response = _client(test_app, with_cookie=False).post(
+            "/api/virtual-servers/virtual/test-vs/toggle", json={"enabled": True}
+        )
+        assert response.status_code == 200
+
+
+# =============================================================================
+# Browser path: session cookie present -> CSRF token required
+# =============================================================================
+
+
+@pytest.mark.unit
+class TestCookieToggleEnforced:
+    """Cookie-bearing requests must be CSRF-protected on EVERY toggle endpoint."""
+
+    def test_agent_toggle_cookie_without_token_rejected(self, test_app, mock_agent_service):
+        response = _client(test_app, with_cookie=True).post(
+            "/api/agents/test-agent/toggle?enabled=true"
+        )
+        assert response.status_code == 403
+        assert response.json()["detail"] == "CSRF validation failed: no token provided"
+
+    def test_agent_toggle_cookie_with_token_ok(
+        self, test_app, mock_agent_service, valid_token
+    ):
+        response = _client(test_app, with_cookie=True).post(
+            "/api/agents/test-agent/toggle?enabled=true",
+            headers={"X-CSRF-Token": valid_token},
+        )
+        assert response.status_code == 200
+
+    def test_skill_toggle_cookie_without_token_rejected(self, test_app, mock_skill_service):
+        response = _client(test_app, with_cookie=True).post(
+            "/api/skills/test-skill/toggle", json={"enabled": True}
+        )
+        assert response.status_code == 403
+
+    def test_skill_toggle_cookie_with_token_ok(
+        self, test_app, mock_skill_service, valid_token
+    ):
+        response = _client(test_app, with_cookie=True).post(
+            "/api/skills/test-skill/toggle",
+            json={"enabled": True},
+            headers={"X-CSRF-Token": valid_token},
+        )
+        assert response.status_code == 200
+
+    def test_virtual_server_toggle_cookie_without_token_rejected(
+        self, test_app, mock_vs_service
+    ):
+        """Regression guard: this endpoint previously had NO CSRF dependency."""
+        response = _client(test_app, with_cookie=True).post(
+            "/api/virtual-servers/virtual/test-vs/toggle", json={"enabled": True}
+        )
+        assert response.status_code == 403
+
+    def test_virtual_server_toggle_cookie_with_token_ok(
+        self, test_app, mock_vs_service, valid_token
+    ):
+        response = _client(test_app, with_cookie=True).post(
+            "/api/virtual-servers/virtual/test-vs/toggle",
+            json={"enabled": True},
+            headers={"X-CSRF-Token": valid_token},
+        )
+        assert response.status_code == 200
+
+    def test_invalid_token_rejected(self, test_app, mock_vs_service):
+        """Forged/garbage token on a cookie request must fail with invalid token."""
+        response = _client(test_app, with_cookie=True).post(
+            "/api/virtual-servers/virtual/test-vs/toggle",
+            json={"enabled": True},
+            headers={"X-CSRF-Token": "forged-value"},
+        )
+        assert response.status_code == 403
+        assert response.json()["detail"] == "CSRF validation failed: invalid token"
+
+    def test_form_encoded_forgery_shape_rejected(self, test_app, mock_vs_service):
+        """Cross-site forms can post text/plain bodies carrying a csrf_token
+        field; the forged value must not validate (attacker cannot know it)."""
+        response = _client(test_app, with_cookie=True).post(
+            "/api/virtual-servers/virtual/test-vs/toggle",
+            data={"enabled": "true", "csrf_token": "forged-value"},
+        )
+        assert response.status_code == 403
