@@ -0,0 +1,112 @@
+"""Unit tests for the session-cookie-conditional CSRF dependency.
+
+Covers the behavior of verify_csrf_token_flexible in registry/auth/csrf.py
+after issue #891: requests carrying the mcp_gateway_session cookie must
+present a valid CSRF token bound to it; requests without the cookie (bearer
+M2M clients, internal JWT callers) skip the check entirely.
+"""
+
+import logging
+from typing import Any
+
+import pytest
+from fastapi import Depends, FastAPI, Request
+from fastapi.testclient import TestClient
+
+from registry.auth.csrf import generate_csrf_token, verify_csrf_token_flexible
+from registry.core.config import settings
+
+logger = logging.getLogger(__name__)
+
+
+@pytest.fixture
+def csrf_app(test_settings) -> FastAPI:
+    """Minimal app with one protected route using the real dependency."""
+    app = FastAPI()
+
+    @app.post("/protected")
+    async def protected(request: Request, _csrf: None = Depends(verify_csrf_token_flexible)):
+        return {"ok": True}
+
+    return app
+
+
+@pytest.fixture
+def csrf_client(csrf_app: FastAPI) -> TestClient:
+    return TestClient(csrf_app)
+
+
+@pytest.fixture
+def session_cookie(test_settings) -> dict[str, str]:
+    return {settings.session_cookie_name: "unit-test-session-value"}
+
+
+@pytest.fixture
+def valid_token(session_cookie) -> str:
+    """CSRF token signed for the fixture session value."""
+    return generate_csrf_token(session_cookie[settings.session_cookie_name])
+
+
+def test_cookie_without_token_rejected(csrf_client, session_cookie):
+    """Cookie-authenticated request with no CSRF token must fail closed."""
+    response = csrf_client.post("/protected", cookies=session_cookie)
+    assert response.status_code == 403
+    assert response.json()["detail"] == "CSRF validation failed: no token provided"
+
+
+def test_cookie_with_valid_header_token_passes(csrf_client, session_cookie, valid_token):
+    response = csrf_client.post(
+        "/protected", cookies=session_cookie, headers={"X-CSRF-Token": valid_token}
+    )
+    assert response.status_code == 200
+
+
+def test_cookie_with_valid_form_token_passes(csrf_client, session_cookie, valid_token):
+    response = csrf_client.post(
+        "/protected", cookies=session_cookie, data={"csrf_token": valid_token}
+    )
+    assert response.status_code == 200
+
+
+def test_cookie_with_invalid_token_rejected(csrf_client, session_cookie):
+    response = csrf_client.post(
+        "/protected",
+        cookies=session_cookie,
+        headers={"X-CSRF-Token": "tampered-or-forged"},
+    )
+    assert response.status_code == 403
+    assert response.json()["detail"] == "CSRF validation failed: invalid token"
+
+
+def test_cookie_with_token_for_other_session_rejected(
+    csrf_client, session_cookie, test_settings
+):
+    """Token signed for a different session must not validate."""
+    other_token = generate_csrf_token("some-other-session")
+    response = csrf_client.post(
+        "/protected", cookies=session_cookie, headers={"X-CSRF-Token": other_token}
+    )
+    assert response.status_code == 403
+
+
+def test_header_token_preferred_over_form_token(csrf_client, session_cookie, valid_token):
+    """Header wins when both are present; a bad form token is then irrelevant."""
+    response = csrf_client.post(
+        "/protected",
+        cookies=session_cookie,
+        headers={"X-CSRF-Token": valid_token},
+        data={"csrf_token": "garbage"},
+    )
+    assert response.status_code == 200
+
+
+def test_no_cookie_skips_check_with_token(csrf_client, valid_token):
+    """Bearer M2M clients send no cookie: the check is skipped."""
+    response = csrf_client.post("/protected", headers={"X-CSRF-Token": valid_token})
+    assert response.status_code == 200
+
+
+def test_no_cookie_skips_check_without_token(csrf_client):
+    """Bearer M2M clients send no cookie and no token: the check is skipped."""
+    response = csrf_client.post("/protected")
+    assert response.status_code == 200
