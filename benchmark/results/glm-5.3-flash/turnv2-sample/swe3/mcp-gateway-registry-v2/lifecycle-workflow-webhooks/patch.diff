+"""
+Shared lifecycle-status query-filter helpers for the servers/agents/skills
+list endpoints.
+
+Kept separate from the route modules (same shape as ``_etag_utils``) so all
+three list endpoints validate and normalize the ``status=`` query parameter
+identically without importing each other.
+"""
+
+from fastapi import HTTPException
+
+from ..schemas.registry_card import _validate_lifecycle_status
+
+
+def resolve_status_filter(status: str | None) -> str | None:
+    """Validate and normalize an optional lifecycle ``status`` query param.
+
+    Args:
+        status: Raw query-parameter value (or None when absent).
+
+    Returns:
+        The normalized (lowercase) status to filter on, or None.
+
+    Raises:
+        HTTPException: 400 when the value is not a known lifecycle status.
+    """
+    if status is None:
+        return None
+    try:
+        return _validate_lifecycle_status(status)
+    except ValueError as e:
+        raise HTTPException(status_code=400, detail=str(e)) from e
