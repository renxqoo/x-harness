     return normalized
 
 
+def resolve_initial_status(supplied: str | None) -> str:
+    """Apply the LIFECYCLE_INITIAL_STATUS mandate to a registration status.
+
+    Policy (Issue #1330):
+    - Mandate off (default): supplied statuses are validated and normalized;
+      an absent status falls back to "active" (the historical default).
+    - Mandate on: an absent status is forced to the mandated value and an
+      explicit mismatched status raises ValueError (routes turn it into a 400).
+
+    The mandate applies to REGISTRATION only; edits are governed by the
+    change_asset_status permission instead.
+
+    Raises:
+        ValueError: If the supplied status is unknown, or conflicts with the
+            configured mandate.
+    """
+    # Lazy import: registry.core.config imports this module's sibling enum via
+    # a validator, so a module-level import would be circular.
+    from ..core.config import settings
+
+    mandated = (settings.lifecycle_initial_status or "").strip().lower()
+    if not mandated:
+        if supplied and supplied.strip():
+            return _validate_lifecycle_status(supplied)
+        return "active"
+    if supplied is None or not str(supplied).strip():
+        return mandated
+    normalized = _validate_lifecycle_status(supplied)
+    if normalized != mandated:
+        raise ValueError(
+            f"status must be '{mandated}' when LIFECYCLE_INITIAL_STATUS is set (got '{normalized}')"
+        )
+    return normalized
+
+
 class RegistryCapabilities(BaseModel):
     """Capabilities supported by this registry."""
 
