     # Remove any existing empty SECRET_KEY line
-    sed -i '/^SECRET_KEY=$/d' .env 2>/dev/null || true
-    sed -i '/^SECRET_KEY=""$/d' .env 2>/dev/null || true
+    remove_env_lines '^SECRET_KEY=$|^SECRET_KEY=""$'
 
