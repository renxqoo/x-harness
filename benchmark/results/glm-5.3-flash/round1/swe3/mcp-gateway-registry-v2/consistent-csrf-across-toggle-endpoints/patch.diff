--- a/registry/auth/csrf.py
+++ b/registry/auth/csrf.py
@@ -155,3 +155,35 @@ async def verify_csrf_token_flexible(
         )
 
     logger.debug("CSRF token verified via flexible dependency")
+
+
+async def verify_csrf_token_if_session_cookie(request: Request) -> None:
+    """FastAPI dependency that enforces CSRF only for cookie-authenticated requests.
+
+    Policy: CSRF protection applies to cookie-authenticated (browser) requests;
+    bearer-authenticated requests are exempt because they carry no forgeable
+    ambient credential. Cross-site attackers cannot attach an Authorization
+    header to a victim's request - they can only ride ambient credentials such
+    as cookies. So:
+
+    - No session cookie -> the request must have authenticated with an explicit
+      credential (OAuth bearer token or internal JWT). CSRF validation is
+      skipped; the route's auth dependency remains the sole authority for
+      identifying the caller.
+    - Session cookie present -> the request may be a forged browser request.
+      A valid session-bound CSRF token is REQUIRED, same rules as
+      verify_csrf_token_flexible.
+
+    The cookie gate runs first and returns before any token parsing, so a
+    tokenless bearer request never reaches a 403 CSRF branch.
+    """
+    session_id = request.cookies.get(settings.session_cookie_name)
+    if not session_id:
+        logger.info(
+            "CSRF check skipped: no session cookie (non-browser/bearer-authenticated request)"
+        )
+        return
+
+    # Cookie present: enforce the full strict check (token via X-CSRF-Token
+    # header or csrf_token form field, validated against the session).
+    await verify_csrf_token_flexible(request)
