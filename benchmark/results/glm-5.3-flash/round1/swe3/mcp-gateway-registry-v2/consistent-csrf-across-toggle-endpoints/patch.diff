+"""
+Unit tests for the session-conditional CSRF dependency.
+
+Covers verify_csrf_token_if_session_cookie in registry/auth/csrf.py:
+
+- No session cookie -> CSRF validation is skipped (bearer/M2M requests pass).
+- Session cookie present -> a valid session-bound CSRF token is required
+  (header or form field), matching verify_csrf_token_flexible semantics.
+- Hybrid requests (cookie + Authorization header) take the stricter branch.
+"""
+
+import logging
+
+import pytest
+from fastapi import Depends, FastAPI
+from fastapi.testclient import TestClient
+
+from registry.auth.csrf import (
+    generate_csrf_token,
+    verify_csrf_token_if_session_cookie,
+)
+from registry.core.config import settings
+
+logger = logging.getLogger(__name__)
+
+SESSION_ID = "test-session-id-0123456789abcdef"
+
+
+@pytest.fixture
+def probe_client():
+    """TestClient for an app whose /probe route requires the CSRF dependency."""
+    from fastapi import Depends
+
+    app = FastAPI()
+
+    @app.post("/probe")
+    async def probe(
+        _csrf: None = Depends(verify_csrf_token_if_session_cookie),
+    ):
+        return {"status": "ok"}
+
+    client = TestClient(app)
+    yield client
+
+
+@pytest.mark.unit
+@pytest.mark.auth
+class TestVerifyCsrfTokenIfSessionCookie:
+    """Tests for verify_csrf_token_if_session_cookie."""
+
+    def test_no_cookie_no_token_passes(self, probe_client):
+        """Bearer-style request without a session cookie skips CSRF entirely."""
+        response = probe_client.post("/probe")
+        assert response.status_code == 200
+        assert response.json() == {"status": "ok"}
+
+    def test_no_cookie_never_validates_token(self, probe_client):
+        """The skip path must not invoke token validation at all."""
+        from unittest.mock import patch
+
+        with patch("registry.auth.csrf.validate_csrf_token") as mock_validate:
+            response = probe_client.post("/probe")
+        assert response.status_code == 200
+        mock_validate.assert_not_called()
+
+    def test_cookie_without_token_rejected(self, probe_client):
+        """Cookie-authenticated request without a token gets the classic 403."""
+        response = probe_client.post(
+            "/probe", cookies={settings.session_cookie_name: SESSION_ID}
+        )
+        assert response.status_code == 403
+        assert response.json()["detail"] == "CSRF validation failed: no token provided"
+
+    def test_cookie_with_invalid_token_rejected(self, probe_client):
+        """Garbage token with a session cookie is rejected."""
+        response = probe_client.post(
+            "/probe",
+            cookies={settings.session_cookie_name: SESSION_ID},
+            headers={"X-CSRF-Token": "not-a-valid-token"},
+        )
+        assert response.status_code == 403
+        assert response.json()["detail"] == "CSRF validation failed: invalid token"
+
