diff --git a/tests/unit/api/test_egress_configure_cli_custom_flags.py b/tests/unit/api/test_egress_configure_cli_custom_flags.py
new file mode 100644
index 0000000..e529914
--- /dev/null
+++ b/tests/unit/api/test_egress_configure_cli_custom_flags.py
@@ -0,0 +1,214 @@
+"""Unit tests for the egress-configure custom-provider CLI flags.
+
+These lock in the CLI/API contract for ``--provider custom``: the five
+``custom_*`` fields the server's ``EgressConfigRequest`` accepts must be
+forwarded from the ``egress-configure`` subparser through
+``RegistryClient.configure_egress_auth`` to
+POST /api/servers/{path}/egress-auth.
+
+Following the client's existing "only send what was supplied" convention,
+omitted flags must be absent from the JSON body (not null), so an edit that
+omits a flag cannot clear a stored value on the server.
+"""
+
+from __future__ import annotations
+
+import sys
+from pathlib import Path
+from types import SimpleNamespace
+from unittest.mock import MagicMock, patch
+
+import pytest
+
+from api.registry_client import RegistryClient
+
+# registry_management.py lives under api/ and imports sibling modules by name.
+_API_DIR = Path(__file__).resolve().parents[3] / "api"
+if str(_API_DIR) not in sys.path:
+    sys.path.insert(0, str(_API_DIR))
+
+import registry_management  # noqa: E402
+
+
+@pytest.fixture
+def client() -> RegistryClient:
+    """A RegistryClient pointed at a dummy URL with a dummy token."""
+    return RegistryClient(registry_url="http://localhost", token="dummy-token-1234567890")
+
+
+def _fake_response() -> MagicMock:
+    response = MagicMock(status_code=200)
+    response.raise_for_status.return_value = None
+    response.json.return_value = {"path": "/github"}
+    return response
+
+
+class TestConfigureEgressAuthPayload:
+    """Tests for the configure_egress_auth request body."""
+
+    def test_custom_flags_forwarded_in_json_body(
+        self,
+        client: RegistryClient,
+    ) -> None:
+        """All five custom_* fields are sent when supplied."""
+        with patch("api.registry_client.requests.request", return_value=_fake_response()) as req:
+            client.configure_egress_auth(
+                server_path="/github",
+                mode="oauth_user",
+                provider="custom",
+                client_id="cid",
+                client_secret="sek",
+                scopes=["openid", "profile"],
+                custom_authorize_url="https://tenant.example.com/oauth2/authorize",
+                custom_token_url="https://tenant.example.com/oauth2/token",
+                custom_scope_separator=" ",
+                custom_token_auth_style="post_body",
+                custom_resource="https://api.example.com",
+            )
+
+        kwargs = req.call_args.kwargs
+        assert kwargs["method"] == "POST"
+        assert kwargs["url"] == "http://localhost/api/servers/github/egress-auth"
+        body = kwargs["json"]
+        assert body["egress_auth_mode"] == "oauth_user"
+        assert body["egress_provider"] == "custom"
+        assert body["client_id"] == "cid"
+        assert body["scopes"] == ["openid", "profile"]
+        assert body["custom_authorize_url"] == "https://tenant.example.com/oauth2/authorize"
+        assert body["custom_token_url"] == "https://tenant.example.com/oauth2/token"
+        assert body["custom_scope_separator"] == " "
+        assert body["custom_token_auth_style"] == "post_body"
+        assert body["custom_resource"] == "https://api.example.com"
+
+    def test_omitted_custom_flags_are_absent_not_null(
+        self,
+        client: RegistryClient,
+    ) -> None:
+        """Omitted optional fields send no key at all (never null)."""
+        with patch("api.registry_client.requests.request", return_value=_fake_response()) as req:
+            client.configure_egress_auth(server_path="/github", mode="none")
+
+        body = req.call_args.kwargs["json"]
+        assert body == {"egress_auth_mode": "none"}
+        assert not any(v is None for v in body.values())
+
+    def test_falsy_custom_values_still_sent(
+        self,
+        client: RegistryClient,
+    ) -> None:
+        """A single-space scope separator and basic_header are still sent."""
+        with patch("api.registry_client.requests.request", return_value=_fake_response()) as req:
+            client.configure_egress_auth(
+                server_path="/github",
+                mode="oauth_user",
+                provider="custom",
+                custom_scope_separator=" ",
+                custom_token_auth_style="basic_header",
+            )
+
+        body = req.call_args.kwargs["json"]
+        assert body["custom_scope_separator"] == " "
+        assert body["custom_token_auth_style"] == "basic_header"
+        assert "custom_authorize_url" not in body
+        assert "custom_token_url" not in body
+        assert "custom_resource" not in body
+
+
+class TestCmdEgressConfigurePassThrough:
+    """Tests for the cmd_egress_configure handler wiring."""
+
+    def test_handler_forwards_custom_flags(self) -> None:
+        """The handler passes every custom_* namespace value to the client."""
+        args = SimpleNamespace(
+            path="/github",
+            mode="oauth_user",
+            provider="custom",
+            client_id="cid",
+            client_secret="sek",
+            scopes="openid,profile",
+            target_audience=None,
+            custom_authorize_url="https://tenant.example.com/oauth2/authorize",
+            custom_token_url="https://tenant.example.com/oauth2/token",
+            custom_scope_separator=None,
+            custom_token_auth_style="post_body",
+            custom_resource=None,
+        )
+        mock_client = MagicMock()
+        mock_client.configure_egress_auth.return_value = {"path": "/github"}
+
+        with patch.object(registry_management, "_create_client", return_value=mock_client):
+            code = registry_management.cmd_egress_configure(args)
+
+        assert code == 0
+        kwargs = mock_client.configure_egress_auth.call_args.kwargs
+        assert kwargs["server_path"] == "/github"
+        assert kwargs["mode"] == "oauth_user"
+        assert kwargs["provider"] == "custom"
+        assert kwargs["scopes"] == ["openid", "profile"]
+        assert kwargs["custom_authorize_url"] == "https://tenant.example.com/oauth2/authorize"
+        assert kwargs["custom_token_url"] == "https://tenant.example.com/oauth2/token"
+        assert kwargs["custom_scope_separator"] is None
+        assert kwargs["custom_token_auth_style"] == "post_body"
+        assert kwargs["custom_resource"] is None
+
+
+class TestEgressConfigureParser:
+    """Tests for egress-configure argparse wiring."""
+
+    def _argv(self, auth_style: str) -> list[str]:
+        return [
+            "registry_management.py",
+            "--registry-url",
+            "https://registry.example.com",
+            "egress-configure",
+            "--path",
+            "/github",
+            "--mode",
+            "oauth_user",
+            "--provider",
+            "custom",
+            "--client-id",
+            "cid",
+            "--client-secret",
+            "sek",
+            "--custom-authorize-url",
+            "https://tenant.example.com/oauth2/authorize",
+            "--custom-token-url",
+            "https://tenant.example.com/oauth2/token",
+            "--custom-token-auth-style",
+            auth_style,
+            "--custom-resource",
+            "https://api.example.com",
+        ]
+
+    def test_parse_accepts_custom_flags(self) -> None:
+        """A full custom invocation parses, runs, and reaches the client."""
+        mock_client = MagicMock()
+        mock_client.configure_egress_auth.return_value = {"path": "/github"}
+
+        with (
+            patch.object(sys, "argv", self._argv("post_body")),
+            patch.object(registry_management, "_create_client", return_value=mock_client),
+        ):
+            assert registry_management.main() == 0
+
+        kwargs = mock_client.configure_egress_auth.call_args.kwargs
+        assert kwargs["provider"] == "custom"
+        assert kwargs["custom_authorize_url"] == "https://tenant.example.com/oauth2/authorize"
+        assert kwargs["custom_token_url"] == "https://tenant.example.com/oauth2/token"
+        assert kwargs["custom_token_auth_style"] == "post_body"
+        assert kwargs["custom_resource"] == "https://api.example.com"
+
+    def test_invalid_token_auth_style_rejected_before_network(self) -> None:
+        """A bad --custom-token-auth-style fails at parse time with exit 2."""
+        mock_client = MagicMock()
+
+        with (
+            patch.object(sys, "argv", self._argv("header")),
+            patch.object(registry_management, "_create_client", return_value=mock_client),
+            pytest.raises(SystemExit) as excinfo,
+        ):
+            registry_management.main()
+
+        assert excinfo.value.code == 2
+        mock_client.configure_egress_auth.assert_not_called()
