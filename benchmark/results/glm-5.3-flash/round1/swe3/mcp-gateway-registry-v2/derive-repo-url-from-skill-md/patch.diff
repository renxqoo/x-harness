+
+@pytest.mark.unit
+class TestSkillSearchResultRepositoryUrl:
+    """SkillSearchResult transports repository_url."""
+
+    def test_repository_url_populated(self):
+        result = SkillSearchResult(
+            path="/skills/test-skill",
+            skill_name="test-skill",
+            description="A test skill",
+            tags=[],
+            skill_md_url="https://github.com/org/repo/blob/main/SKILL.md",
+            repository_url="https://github.com/org/repo",
+            relevance_score=0.9,
+        )
+        assert result.repository_url == "https://github.com/org/repo"
+
+    def test_repository_url_defaults_to_none(self):
+        result = SkillSearchResult(
+            path="/skills/test-skill",
+            skill_name="test-skill",
+            relevance_score=0.5,
+        )
+        assert result.repository_url is None
+
+
