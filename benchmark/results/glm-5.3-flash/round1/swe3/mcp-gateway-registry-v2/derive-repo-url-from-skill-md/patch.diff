+"""
+Unit tests for repository_url plumbing in skill routes.
+
+Covers the three sites the expert review flagged as must-fix:
+
+1. /parse-skill-md returns the derived repository_url (or null).
+2. The fast-path SkillInfo construction in list_skills (unrestricted
+   user, no field filters) exposes repository_url.
+3. The fallback listing path (restricted user or field filters, served
+   by skill_service.list_skills_for_user) exposes repository_url.
+"""
+
+from unittest.mock import (
+    AsyncMock,
+    MagicMock,
+    patch,
+)
+from urllib.parse import quote
+from uuid import uuid4
+
+import pytest
+from fastapi import FastAPI
+from fastapi.testclient import TestClient
+from pydantic import HttpUrl
+
+from registry.schemas.skill_models import SkillCard
+from registry.schemas.skill_models import SkillInfo
+from registry.services.skill_service import SkillService
+
+
+# =============================================================================
+# HELPERS
+# =============================================================================
+
+
+def _make_skill_card(repository_url: str | None) -> SkillCard:
+    """Create a minimal SkillCard with a configurable repository_url."""
+    return SkillCard(
+        path="/skills/test-skill",
+        name="test-skill",
+        description="A test skill",
+        skill_md_url=HttpUrl("https://github.com/org/repo/blob/main/SKILL.md"),
+        skill_md_raw_url=HttpUrl(
+            "https://raw.githubusercontent.com/org/repo/refs/heads/main/SKILL.md"
+        ),
+        repository_url=HttpUrl(repository_url) if repository_url else None,
+        tags=["test"],
+    )
+
+
+def _restricted_user_context() -> dict:
+    """User context without unrestricted access, forcing the fallback path."""
+    return {
+        "username": "limited-user",
+        "is_admin": False,
+        "groups": [],
+        "scopes": [],
+        "accessible_servers": [],
+        "accessible_services": [],
+        "accessible_agents": [],
+        "auth_method": "session",
+    }
+
+
+def _make_client(
+    app: FastAPI,
+    skill_service: MagicMock,
+    user_context: dict | None = None,
+) -> tuple[TestClient, MagicMock]:
+    """Create a TestClient with auth and skill-service dependencies mocked."""
+    from registry.auth.dependencies import nginx_proxied_auth
+
+    if user_context is None:
+        user_context = {
+            "username": "admin",
+            "is_admin": True,
+            "groups": ["mcp-registry-admin"],
+            "scopes": [],
+            "accessible_servers": ["all"],
+            "accessible_services": ["all"],
+            "accessible_agents": ["all"],
+            "auth_method": "session",
+        }
+
+    app.dependency_overrides[nginx_proxied_auth] = lambda: user_context
+
+    with (
+        patch(
+            "registry.api.skill_routes.get_skill_service",
+            return_value=skill_service,
+        ),
+        patch("registry.search.service.faiss_service", MagicMock()),
+        patch("registry.health.service.health_service", MagicMock()),
+        patch("registry.core.nginx_service.nginx_service", MagicMock()),
+    ):
+        client = TestClient(app, cookies={"mcp_gateway_session": "test-session"})
+        yield client
+
+    app.dependency_overrides.clear()
+
+
+@pytest.fixture
+def admin_client_factory():
+    """Factory fixture wrapping _make_client as a context manager."""
+    from contextlib import contextmanager
+
+    @contextmanager
+    def _factory(
+        app: FastAPI,
+        skill_service: MagicMock,
+        user_context: dict | None = None,
+    ):
+        gen = _make_client(app, skill_service, user_context)
+        try:
+            yield next(gen)
+        finally:
+            try:
+                next(gen)
+            except StopIteration:
+                pass
+
+    return _factory
+
+
+@pytest.fixture
+def app() -> FastAPI:
+    """The registry FastAPI app under test."""
+    from registry.main import app as registry_app
+
+    return registry_app
+
+
+# =============================================================================
+# TESTS
+# =============================================================================
+
+
+@pytest.mark.unit
+class TestParseSkillMdRepositoryUrl:
+    """The parse response carries the derived repository_url."""
+
+    def test_github_blob_url_derives_repository(
+        self,
+        app: FastAPI,
+        admin_client_factory,
+    ):
+        skill_service = MagicMock(spec=SkillService)
+        skill_service.parse_skill_md = AsyncMock(
+            return_value={
+                "name": "foo",
+                "name_slug": "foo",
+                "description": "A test skill",
+                "version": None,
+                "tags": [],
+                "content_version": "abc123",
+                "skill_md_url": "https://github.com/org/repo/blob/main/skills/foo/SKILL.md",
+                "skill_md_raw_url": (
+                    "https://raw.githubusercontent.com/org/repo/refs/heads/main/skills/foo/SKILL.md"
+                ),
+                "repository_url": "https://github.com/org/repo",
+            }
+        )
+
+        with admin_client_factory(app, skill_service) as client:
+            response = client.post(
+                "/api/skills/parse-skill-md?url="
+                + quote("https://github.com/org/repo/blob/main/skills/foo/SKILL.md", safe="")
+            )
+
+        assert response.status_code == 200
+        data = response.json()
+        assert data["success"] is True
+        assert data["repository_url"] == "https://github.com/org/repo"
+
+    def test_non_github_url_yields_null(
+        self,
+        app: FastAPI,
+        admin_client_factory,
+    ):
+        skill_service = MagicMock(spec=SkillService)
+        skill_service.parse_skill_md = AsyncMock(
+            return_value={
+                "name": "foo",
+                "name_slug": "foo",
+                "description": "A test skill",
+                "version": None,
+                "tags": [],
+                "content_version": "abc123",
+                "skill_md_url": "https://gitlab.com/org/repo/-/blob/main/SKILL.md",
+                "skill_md_raw_url": "https://gitlab.com/org/repo/-/blob/main/SKILL.md",
+                "repository_url": None,
+            }
+        )
+
+        with admin_client_factory(app, skill_service) as client:
+            response = client.post(
+                "/api/skills/parse-skill-md?url="
+                + quote("https://gitlab.com/org/repo/-/blob/main/SKILL.md", safe="")
+            )
+
+        assert response.status_code == 200
+        data = response.json()
+        assert data["success"] is True
+        assert data["repository_url"] is None
+
+
+@pytest.mark.unit
+class TestListSkillsRepositoryUrl:
+    """Both SkillInfo listing paths expose repository_url."""
+
+    def test_fast_path_includes_repository_url(
+        self,
+        app: FastAPI,
+        admin_client_factory,
+    ):
+        # Unrestricted admin + no field filters -> fast path (DB pagination).
+        skill_service = MagicMock(spec=SkillService)
+        skill_service.get_skills_paginated = AsyncMock(
+            return_value=([_make_skill_card("https://github.com/org/repo")], 1)
+        )
+
+        with admin_client_factory(app, skill_service) as client:
+            response = client.get("/api/skills?limit=10")
+
+        assert response.status_code == 200
+        body = response.json()
+        assert body["total_count"] == 1
+        assert body["skills"][0]["repository_url"] == "https://github.com/org/repo"
+
+    def test_fallback_path_includes_repository_url(
+        self,
+        app: FastAPI,
+        admin_client_factory,
+    ):
+        # Tag filter forces the fallback path through list_skills_for_user.
+        skill_info = SkillInfo(
+            id=uuid4(),
+            path="/skills/test-skill",
+            name="test-skill",
+            description="A test skill",
+            skill_md_url="https://github.com/org/repo/blob/main/SKILL.md",
+            repository_url="https://github.com/org/repo",
+            tags=["test"],
+        )
+        skill_service = MagicMock(spec=SkillService)
+        skill_service.list_skills_for_user = AsyncMock(return_value=[skill_info])
+
+        with admin_client_factory(app, skill_service) as client:
+            response = client.get("/api/skills?tag=test")
+
+        assert response.status_code == 200
+        body = response.json()
+        assert body["skills"][0]["repository_url"] == "https://github.com/org/repo"
+
+    def test_fallback_path_null_repository_url_for_legacy_skills(
+        self,
+        app: FastAPI,
+        admin_client_factory,
+    ):
+        # Pre-change skill (no stored repository_url) must serialize as null.
+        skill_info = SkillInfo(
+            id=uuid4(),
+            path="/skills/legacy",
+            name="legacy",
+            description="Legacy skill",
+            skill_md_url="https://example.com/SKILL.md",
+            repository_url=None,
+            tags=["test"],
+        )
+        skill_service = MagicMock(spec=SkillService)
+        skill_service.list_skills_for_user = AsyncMock(return_value=[skill_info])
+
+        with admin_client_factory(app, skill_service) as client:
+            response = client.get("/api/skills?tag=test")
+
+        assert response.status_code == 200
+        assert response.json()["skills"][0]["repository_url"] is None
