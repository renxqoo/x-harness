+"""Unit tests for derive_repository_url in registry/utils/url_utils.py."""
+
+import pytest
+
+from registry.utils.url_utils import derive_repository_url
+
+
+class TestDeriveRepositoryUrlPublicGithub:
+    """Tests for public GitHub URL shapes."""
+
+    def test_blob_url(self):
+        assert (
+            derive_repository_url("https://github.com/org/repo/blob/main/skills/foo/SKILL.md")
+            == "https://github.com/org/repo"
+        )
+
+    def test_blob_url_nested_path(self):
+        assert (
+            derive_repository_url(
+                "https://github.com/my-org/my.repo/blob/feature/x/deep/nested/SKILL.md"
+            )
+            == "https://github.com/my-org/my.repo"
+        )
+
+    def test_raw_url_refs_heads(self):
+        assert (
+            derive_repository_url(
+                "https://raw.githubusercontent.com/org/repo/refs/heads/main/skills/foo/SKILL.md"
+            )
+            == "https://github.com/org/repo"
+        )
+
+    def test_raw_url_legacy_shape(self):
+        assert (
+            derive_repository_url("https://raw.githubusercontent.com/org/repo/main/SKILL.md")
+            == "https://github.com/org/repo"
+        )
+
+
+class TestDeriveRepositoryUrlEnterprise:
+    """Tests for GitHub Enterprise URL shapes."""
+
+    def test_enterprise_blob_url(self):
+        assert (
+            derive_repository_url("https://github.mycompany.com/org/repo/blob/main/SKILL.md")
+            == "https://github.mycompany.com/org/repo"
+        )
+
+    def test_enterprise_raw_url(self):
+        assert (
+            derive_repository_url(
+                "https://raw.github.mycompany.com/org/repo/refs/heads/main/SKILL.md"
+            )
+            == "https://github.mycompany.com/org/repo"
+        )
+
+    def test_enterprise_host_with_github_infix(self):
+        assert (
+            derive_repository_url("https://mycompany-github.com/org/repo/blob/main/SKILL.md")
+            == "https://mycompany-github.com/org/repo"
+        )
+
+
+class TestDeriveRepositoryUrlNonGithub:
+    """Non-GitHub hosts must yield None rather than a guess."""
+
+    def test_gitlab_url(self):
+        assert (
+            derive_repository_url("https://gitlab.com/org/repo/-/blob/main/SKILL.md") is None
+        )
+
+    def test_bitbucket_url(self):
+        assert derive_repository_url("https://bitbucket.org/org/repo/src/main/SKILL.md") is None
+
+    def test_generic_domain(self):
+        assert derive_repository_url("https://example.com/SKILL.md") is None
+
+    def test_generic_domain_with_blob_shape(self):
+        assert (
+            derive_repository_url("https://example.com/org/repo/blob/main/SKILL.md") is None
+        )
+
+
+class TestDeriveRepositoryUrlNoGuessing:
+    """GitHub hosts without a supported file shape must yield None."""
+
+    def test_repo_root_without_file_path(self):
+        assert derive_repository_url("https://github.com/org/repo") is None
+
+    def test_org_root(self):
+        assert derive_repository_url("https://github.com/org") is None
+
+    def test_blob_url_without_file_path(self):
+        assert derive_repository_url("https://github.com/org/repo/blob/main") is None
+
+    def test_owner_only_raw_path(self):
+        assert derive_repository_url("https://raw.githubusercontent.com/org") is None
+
+
+class TestDeriveRepositoryUrlMalformed:
+    """Malformed or hostile input must yield None, never raise."""
+
+    def test_empty_string(self):
+        assert derive_repository_url("") is None
+
+    def test_none_like_empty_after_strip(self):
+        assert derive_repository_url("   ") is None
+
+    def test_javascript_scheme(self):
+        assert derive_repository_url("javascript:alert(1)") is None
+
+    def test_ftp_scheme(self):
+        assert derive_repository_url("ftp://github.com/org/repo/blob/main/SKILL.md") is None
+
+    def test_no_scheme(self):
+        assert derive_repository_url("github.com/org/repo/blob/main/SKILL.md") is None
+
+    def test_credentials_spoofing_github_in_username(self):
+        # urlparse: hostname is evil.com; the github.com in userinfo must not count.
+        assert (
+            derive_repository_url("https://github.com@evil.com/org/repo/blob/main/SKILL.md")
+            is None
+        )
+
+    def test_whitespace_is_stripped(self):
+        assert (
+            derive_repository_url("  https://github.com/org/repo/blob/main/SKILL.md  ")
+            == "https://github.com/org/repo"
+        )
+
+
+class TestDeriveRepositoryUrlRoundTrip:
+    """Derivation is the inverse of translate_skill_url for supported shapes."""
+
+    @pytest.mark.parametrize(
+        "skill_url",
+        [
+            "https://github.com/org/repo/blob/main/path/SKILL.md",
+            "https://raw.githubusercontent.com/org/repo/refs/heads/main/path/SKILL.md",
+        ],
+    )
+    def test_derived_repo_is_common_prefix(self, skill_url):
+        from registry.utils.url_utils import translate_skill_url
+
+        user_url, raw_url = translate_skill_url(skill_url)
+        repo_url = derive_repository_url(skill_url)
+        assert repo_url is not None
+        assert user_url.startswith(repo_url)
+        assert raw_url.startswith(
+            repo_url.replace("https://github.com", "https://raw.githubusercontent.com")
+            + "/refs/heads/"
+        ) or raw_url.startswith(repo_url + "/")
