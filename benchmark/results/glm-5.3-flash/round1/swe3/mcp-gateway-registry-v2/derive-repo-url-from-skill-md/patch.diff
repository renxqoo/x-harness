+"""
+Unit tests for repository_url plumbing in the semantic search layer.
+
+Covers:
+1. Index-time metadata: indexing a SkillCard stores repository_url.
+2. search_routes.SkillSearchResult carries repository_url from the
+   projected hit entry.
+"""
+
+from unittest.mock import (
+    AsyncMock,
+    MagicMock,
+    patch,
+)
+from uuid import uuid4
+
