index a273857..0141ff3 100644
--- a/registry/utils/url_utils.py
+++ b/registry/utils/url_utils.py
@@ -120,6 +120,81 @@ def _translate_github_url_to_raw(
     return raw_url
 
 
+def derive_repository_url(
+    url: str,
+) -> str | None:
+    """Derive the repository root URL from a SKILL.md URL.
+
+    Supports the URL shapes users paste into the registration form:
+
+    - github.com/org/repo/blob/<branch>/<path>/SKILL.md
+      -> https://github.com/org/repo
+    - raw.githubusercontent.com/org/repo/refs/heads/<branch>/<path>/SKILL.md
+      -> https://github.com/org/repo
+    - Enterprise equivalents:
+      github.mycompany.com/org/repo/blob/<branch>/<path>/SKILL.md
+        -> https://github.mycompany.com/org/repo
+      raw.github.mycompany.com/org/repo/refs/heads/<branch>/<path>/SKILL.md
+        -> https://github.mycompany.com/org/repo
+
+    This is the inverse of _translate_github_url_to_raw: it maps a file
+    URL back to the repository root that hosts it.
+
+    Args:
+        url: The SKILL.md URL provided by the user
+
+    Returns:
+        The repository root URL, or None when the URL is not a GitHub
+        file URL whose repository can be derived (non-GitHub hosts such
+        as GitLab or Bitbucket, GitHub hosts without a blob/raw file
+        path, or unparseable URLs). Never guesses.
+    """
+    url = (url or "").strip()
+    if not url:
+        return None
+
+    parsed = urlparse(url)
+    hostname = parsed.hostname or ""
+    if parsed.scheme not in ("http", "https") or not hostname:
+        return None
+
+    # Only GitHub instances (public or enterprise) are supported.
+    if not _is_github_hostname(hostname):
+        logger.debug(f"Non-GitHub URL, no repository derived: {url}")
+        return None
+
+    hostname_lower = hostname.lower()
+    path = parsed.path or ""
+
+    # Case 1: raw URL on a raw.* GitHub host (raw.githubusercontent.com
+    # or raw.github.mycompany.com). Shapes:
+    #   /<owner>/<repo>/refs/heads/<branch>/<path>
+    #   /<owner>/<repo>/<branch>/<path>   (legacy raw shape)
+    if _is_raw_github_url(hostname_lower):
+        raw_pattern = re.compile(r"^/([^/]+)/([^/]+)/(?:refs/heads/)?([^/]+)(?:/.+)?$")
+        match = raw_pattern.match(path)
+        if not match:
+            logger.debug(f"Raw GitHub URL path doesn't match expected shape, no repository derived: {url}")
+            return None
+        owner, repo = match.group(1), match.group(2)
+        if hostname_lower == "raw.githubusercontent.com":
+            repo_host = "github.com"
+        else:
+            # e.g. raw.github.mycompany.com -> github.mycompany.com
+            repo_host = hostname_lower[4:]
+        return f"https://{repo_host}/{owner}/{repo}"
+
+    # Case 2: blob/raw file URL on github.com or an enterprise host.
+    # Shape: /<owner>/<repo>/(blob|raw)/<branch>/<path>
+    blob_pattern = re.compile(r"^/([^/]+)/([^/]+)/(?:blob|raw)/([^/]+)(?:/.+)?$")
+    match = blob_pattern.match(path)
+    if not match:
+        logger.debug(f"GitHub URL path doesn't match blob pattern, no repository derived: {url}")
+        return None
+    owner, repo = match.group(1), match.group(2)
+    return f"https://{hostname_lower}/{owner}/{repo}"
+
+
 def translate_skill_url(
     url: str,
 ) -> tuple[str, str]:
