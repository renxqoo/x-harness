+class TestMcpProxyUpstreamTimeoutConfig:
+    """The /mcp-proxy hop's upstream timeout is configurable via
+    MCP_PROXY_UPSTREAM_TIMEOUT_SECONDS (settings field with env fallback),
+    replacing the hardcoded httpx.AsyncClient(timeout=30.0).
+
+    Each test drives the real FastAPI route end-to-end (valid minted
+    X-Internal-Token, mocked httpx upstream) and asserts on the timeout
+    kwarg the handler actually passed to the AsyncClient constructor --
+    pinning the wiring, not just the reader helper.
+    """
+
+    def _drive_proxy(self, mock_cls) -> None:
+        """Common request body: post an initialize through the proxy and
+        assert 200, so each test only differs in its config patching."""
+        import auth_server.server as server_module
+
+        upstream_resp = _build_mock_upstream_response(
+            status_code=200,
+            headers={"content-type": "application/json"},
+            body=b'{"jsonrpc":"2.0","id":1,"result":{}}',
+        )
+        with _patch_httpx_async_client(upstream_resp) as captured_cls:
+            client = TestClient(server_module.app)
+            response = client.post(
+                "/mcp-proxy/office-docs",
+                json={"jsonrpc": "2.0", "id": 1, "method": "initialize"},
+                headers=_mcp_proxy_token_headers(),
+            )
+        assert response.status_code == 200
+        mock_cls.append(captured_cls)
+
+    def test_default_timeout_is_30(self):
+        """No settings value, no env var: the wired timeout is the same
+        30.0 the handler hardcoded before this knob existed."""
+        import auth_server.server as server_module
+
+        captured: list = []
+        env = {k: v for k, v in os.environ.items() if k != "MCP_PROXY_UPSTREAM_TIMEOUT_SECONDS"}
+        with (
+            patch.object(
+                server_module.settings,
+                "mcp_proxy_upstream_timeout_seconds",
+                None,
+                create=True,
+            ),
+            patch.dict(os.environ, env, clear=True),
+        ):
+            self._drive_proxy(captured)
+        assert captured[0].call_args.kwargs["timeout"] == 30.0
+
+    def test_env_override_raises_timeout(self):
+        """Setting the env var changes what the handler passes upstream."""
+        import auth_server.server as server_module
+
+        captured: list = []
+        env = {k: v for k, v in os.environ.items() if k != "MCP_PROXY_UPSTREAM_TIMEOUT_SECONDS"}
+        env["MCP_PROXY_UPSTREAM_TIMEOUT_SECONDS"] = "120"
+        with (
+            patch.object(
+                server_module.settings,
+                "mcp_proxy_upstream_timeout_seconds",
+                None,
+                create=True,
+            ),
+            patch.dict(os.environ, env, clear=True),
+        ):
+            self._drive_proxy(captured)
+        assert captured[0].call_args.kwargs["timeout"] == 120.0
+
+    def test_floor_clamps_to_one_second(self):
+        """Sub-1 values are clamped up to the 1s floor, never passed
+        through -- a near-zero timeout would disable the hop in practice,
+        and 0/None would mean 'no timeout' for httpx."""
+        import auth_server.server as server_module
+
+        captured: list = []
+        env = {k: v for k, v in os.environ.items() if k != "MCP_PROXY_UPSTREAM_TIMEOUT_SECONDS"}
+        env["MCP_PROXY_UPSTREAM_TIMEOUT_SECONDS"] = "0.25"
+        with (
+            patch.object(
+                server_module.settings,
+                "mcp_proxy_upstream_timeout_seconds",
+                None,
+                create=True,
+            ),
+            patch.dict(os.environ, env, clear=True),
+        ):
+            self._drive_proxy(captured)
+        assert captured[0].call_args.kwargs["timeout"] == 1.0
+
+    def test_junk_env_falls_back_to_default(self):
+        """A non-numeric env value warns and uses the 30s default instead
+        of crashing the request."""
+        import auth_server.server as server_module
+
+        captured: list = []
+        env = {k: v for k, v in os.environ.items() if k != "MCP_PROXY_UPSTREAM_TIMEOUT_SECONDS"}
+        env["MCP_PROXY_UPSTREAM_TIMEOUT_SECONDS"] = "banana"
+        with (
+            patch.object(
+                server_module.settings,
+                "mcp_proxy_upstream_timeout_seconds",
+                None,
+                create=True,
+            ),
+            patch.dict(os.environ, env, clear=True),
+        ):
+            self._drive_proxy(captured)
+        assert captured[0].call_args.kwargs["timeout"] == 30.0
+
+    def test_non_finite_env_falls_back_to_default(self):
+        """nan/inf parse as floats but are rejected: the timeout must
+        stay a bounded, finite cap (inf would mean 'no timeout')."""
+        import auth_server.server as server_module
+
+        for bad in ("nan", "inf", "-inf"):
+            captured: list = []
+            env = {
+                k: v
+                for k, v in os.environ.items()
+                if k != "MCP_PROXY_UPSTREAM_TIMEOUT_SECONDS"
+            }
+            env["MCP_PROXY_UPSTREAM_TIMEOUT_SECONDS"] = bad
+            with (
+                patch.object(
+                    server_module.settings,
+                    "mcp_proxy_upstream_timeout_seconds",
+                    None,
+                    create=True,
+                ),
+                patch.dict(os.environ, env, clear=True),
