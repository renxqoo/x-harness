+"""Route-level unit tests for the registration admission control gate.
+
+Verifies that the seven registration/update paths consult the gate and
+map its verdicts to the documented HTTP responses: 200-allow proceeds,
+403-deny surfaces the gate reason, and gate failure returns 503 with the
+fixed fail-closed message. The disabled-flag no-op is covered by the
+client tests in tests/unit/services/test_registration_gate.py.
+"""
+
+import logging
+from typing import Any
+from unittest.mock import AsyncMock, MagicMock, patch
+
+import pytest
+from fastapi import FastAPI, status
+from fastapi.testclient import TestClient
+
+from registry.api.agent_routes import router as agent_router
+from registry.api.skill_routes import router as skill_router
+from registry.schemas.agent_models import AgentCard
+from registry.services.registration_gate import (
+    GATE_UNAVAILABLE_MESSAGE,
+    GateDecision,
+)
+
+logger = logging.getLogger(__name__)
+
+
+# =============================================================================
+# FIXTURES
+# =============================================================================
+
+
+@pytest.fixture
+def user_context() -> dict[str, Any]:
+    """Authenticated user with publish permissions."""
+    return {
+        "username": "testuser",
+        "groups": ["test-group"],
+        "scopes": ["read:agents", "write:agents"],
+        "auth_method": "session",
+        "provider": "local",
+        "accessible_servers": ["all"],
+        "accessible_services": ["all"],
+        "accessible_agents": ["all"],
+        "ui_permissions": {
+            "publish_agent": ["all"],
+            "register_service": ["all"],
+            "modify_service": ["all"],
+        },
+        "can_modify_servers": True,
+        "is_admin": False,
+    }
+
+
+def _agent_app(user_context: dict[str, Any]) -> TestClient:
+    """Test client for agent routes with mocked auth."""
+    from registry.auth.csrf import verify_csrf_token_flexible
+    from registry.auth.dependencies import nginx_proxied_auth
+
+    app = FastAPI()
+    app.include_router(agent_router)
+    app.dependency_overrides[nginx_proxied_auth] = lambda: user_context
+    app.dependency_overrides[verify_csrf_token_flexible] = lambda: None
+    return TestClient(app)
+
+
+def _skill_app(user_context: dict[str, Any]) -> TestClient:
+    """Test client for skill routes with mocked auth."""
+    from registry.auth.csrf import verify_csrf_token_flexible
+    from registry.auth.dependencies import nginx_proxied_auth
+
+    app = FastAPI()
+    app.include_router(skill_router)
+    app.dependency_overrides[nginx_proxied_auth] = lambda: user_context
+    app.dependency_overrides[verify_csrf_token_flexible] = lambda: None
+    return TestClient(app)
+
+
+AGENT_REQUEST = {
+    "name": "gate-agent",
+    "description": "d",
+    "url": "http://localhost:9000/agent",
+    "version": "1.0",
+    "protocol_version": "1.0",
+    "tags": "",
+    "supported_protocol": "a2a",
+    "provider": None,
+    "security_schemes": {},
+    "skills": [],
+    "visibility": "public",
+}
+
+
+def _allow() -> GateDecision:
+    return GateDecision(allowed=True, reason="allowed")
+
+
+def _deny() -> GateDecision:
+    return GateDecision(allowed=False, reason="naming violation", failure=False)
+
+
+def _failure() -> GateDecision:
+    return GateDecision(allowed=False, reason=GATE_UNAVAILABLE_MESSAGE, failure=True)
+
+
+def _validation_ok() -> MagicMock:
+    result = MagicMock()
+    result.is_valid = True
+    result.errors = []
+    result.warnings = []
+    return result
+
+
