+# AGENT ROUTES
+# =============================================================================
+
+
+@pytest.mark.unit
+@pytest.mark.api
+class TestAgentRegistrationGate:
+    """Gate enforcement on POST /agents/register and PUT /agents/{path}."""
+
+    def test_register_allow(self, user_context):
+        client = _agent_app(user_context)
+        with (
+            patch(
+                "registry.api.agent_routes.check_registration_gate",
+                new=AsyncMock(return_value=_allow()),
+            ),
+            patch("registry.api.agent_routes.agent_service") as mock_service,
+            patch("registry.utils.agent_validator.agent_validator") as mock_validator,
+            patch("registry.search.service.faiss_service") as mock_faiss,
+        ):
+            mock_service.get_agent_info = AsyncMock(return_value=None)
+            mock_service.register_agent = AsyncMock(return_value=True)
+            mock_service.is_agent_enabled.return_value = True
+            mock_validator.validate_agent_card = AsyncMock(return_value=_validation_ok())
+            mock_faiss.add_or_update_entity = AsyncMock()
+
+            response = client.post("/agents/register", json=AGENT_REQUEST)
+        assert response.status_code == status.HTTP_201_CREATED
+
+    def test_register_deny_surfaces_reason(self, user_context):
+        client = _agent_app(user_context)
+        with patch(
+            "registry.api.agent_routes.check_registration_gate",
+            new=AsyncMock(return_value=_deny()),
+        ), patch("registry.api.agent_routes.agent_service") as mock_service:
+            mock_service.get_agent_info = AsyncMock(return_value=None)
+
+            response = client.post("/agents/register", json=AGENT_REQUEST)
+        assert response.status_code == status.HTTP_403_FORBIDDEN
+        assert "naming violation" in response.json()["detail"]
+        mock_service.register_agent.assert_not_called()
+
+    def test_register_failure_returns_503_fixed_message(self, user_context):
+        client = _agent_app(user_context)
+        with patch(
+            "registry.api.agent_routes.check_registration_gate",
+            new=AsyncMock(return_value=_failure()),
+        ):
+            response = client.post("/agents/register", json=AGENT_REQUEST)
+        assert response.status_code == status.HTTP_503_SERVICE_UNAVAILABLE
+        assert response.json()["detail"] == GATE_UNAVAILABLE_MESSAGE
+
+    def test_register_gate_called_with_routing_fields(self, user_context):
+        client = _agent_app(user_context)
+        with (
+            patch(
+                "registry.api.agent_routes.check_registration_gate",
+                new=AsyncMock(return_value=_allow()),
+            ) as mock_gate,
+            patch("registry.api.agent_routes.agent_service") as mock_service,
+            patch("registry.utils.agent_validator.agent_validator") as mock_validator,
+            patch("registry.search.service.faiss_service") as mock_faiss,
+        ):
+            mock_service.get_agent_info = AsyncMock(return_value=None)
+            mock_service.register_agent = AsyncMock(return_value=True)
+            mock_service.is_agent_enabled.return_value = True
+            mock_validator.validate_agent_card = AsyncMock(return_value=_validation_ok())
+            mock_faiss.add_or_update_entity = AsyncMock()
+
+            response = client.post("/agents/register", json=AGENT_REQUEST)
+        assert response.status_code == status.HTTP_201_CREATED
+        kwargs = mock_gate.call_args.kwargs
+        assert kwargs["asset_type"] == "agent"
+        assert kwargs["endpoint"] == "/agents/register"
+        assert kwargs["action"] == "register"
+        assert kwargs["username"] == "testuser"
+        assert kwargs["path"] == "/gate-agent"
+
+    def test_update_deny(self, user_context):
+        """A denied agent update surfaces the gate reason as 403."""
+        client = _agent_app(user_context)
+        existing = AgentCard(
+            protocol_version="1.0",
+            name="gate-agent",
+            description="d",
+            url="http://localhost:9000/agent",
+            version="1.0",
+            path="/gate-agent",
+            registered_by="testuser",
+            supported_protocol="a2a",
+        )
+
+        with patch(
+            "registry.api.agent_routes.check_registration_gate",
+            new=AsyncMock(return_value=_deny()),
+        ) as mock_gate, patch("registry.api.agent_routes.agent_service") as mock_service:
+            mock_service.get_agent_info = AsyncMock(return_value=existing)
+
+            response = client.put("/agents/gate-agent", json=AGENT_REQUEST)
+        assert response.status_code == status.HTTP_403_FORBIDDEN
+        assert "naming violation" in response.json()["detail"]
+        kwargs = mock_gate.call_args.kwargs
+        assert kwargs["action"] == "update"
+        assert kwargs["endpoint"] == "/agents/gate-agent"
+
