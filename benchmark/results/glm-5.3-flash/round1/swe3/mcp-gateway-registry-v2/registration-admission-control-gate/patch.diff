+"""Unit tests for the registration admission control gate client.
+
+Covers the verdict matrix (allow, deny, timeout, unreachable, unexpected
+status), the disabled no-op, misconfiguration fail-closed behavior, and
+credential scrubbing of the outbound payload.
+"""
+
+import logging
+from unittest.mock import AsyncMock, MagicMock, patch
+
+import httpx
+import pytest
+
+from registry.services.registration_gate import (
+    GATE_DENIED_FALLBACK_MESSAGE,
+    GATE_UNAVAILABLE_MESSAGE,
+    GateDecision,
+    _build_gate_payload,
+    check_registration_gate,
+)
+
+logger = logging.getLogger(__name__)
+
+
+# =============================================================================
+# FIXTURES
+# =============================================================================
+
+
+@pytest.fixture
+def gate_enabled():
+    """Enable the registration gate with a stub URL."""
+    with (
+        patch("registry.services.registration_gate.settings") as mock_settings,
+    ):
+        mock_settings.registration_gate_enabled = True
+        mock_settings.registration_gate_url = "http://gate.example.com/admit"
+        mock_settings.registration_gate_timeout_seconds = 5.0
+        mock_settings.registration_gate_auth_header = "Authorization"
+        mock_settings.registration_gate_auth_token = ""
+        yield mock_settings
+
+
+@pytest.fixture
+def gate_disabled():
+    """Disable the registration gate (default configuration)."""
+    with patch("registry.services.registration_gate.settings") as mock_settings:
+        mock_settings.registration_gate_enabled = False
+        yield mock_settings
+
+
+def _mock_response(status_code: int, json_body=None):
+    response = MagicMock()
+    response.status_code = status_code
+    if json_body is None:
+        response.json.side_effect = ValueError("not json")
+    else:
+        response.json.return_value = json_body
+    return response
+
+
+SAMPLE_PAYLOAD = {
+    "name": "test-server",
+    "path": "/test-server",
+    "proxy_pass_url": "http://localhost:8080",
+    "auth_credential": "super-secret",
+    "auth_credential_encrypted": "enc",
+    "tags": ["a"],
+}
+
+
+# =============================================================================
+# TESTS
+# =============================================================================
+
+
+@pytest.mark.unit
+@pytest.mark.services
+class TestCheckRegistrationGate:
+    """Tests for check_registration_gate verdicts."""
+
+    @pytest.mark.asyncio
+    async def test_disabled_gate_allows_without_http(self, gate_disabled):
+        """Disabled gate allows immediately and makes no HTTP call."""
+        with patch("registry.services.registration_gate.httpx.AsyncClient") as mock_client:
+            decision = await check_registration_gate(
+                "server", "/register", "register", SAMPLE_PAYLOAD
+            )
+        assert decision.allowed is True
+        assert decision.failure is False
+        mock_client.assert_not_called()
+
+    @pytest.mark.asyncio
+    async def test_allow_on_200(self, gate_enabled):
+        """HTTP 200 allows the registration."""
+        with patch(
+            "registry.services.registration_gate.httpx.AsyncClient"
+        ) as mock_client_cls:
+            client = AsyncMock()
+            client.post = AsyncMock(return_value=_mock_response(200, {"status": "ok"}))
+            client.__aenter__ = AsyncMock(return_value=client)
+            client.__aexit__ = AsyncMock(return_value=False)
+            mock_client_cls.return_value = client
+
+            decision = await check_registration_gate(
+                "server", "/register", "register", SAMPLE_PAYLOAD
+            )
+        assert decision.allowed is True
+        assert decision.failure is False
+        assert client.post.await_count == 1
+
+    @pytest.mark.asyncio
+    async def test_deny_on_403_with_reason(self, gate_enabled):
+        """HTTP 403 with a reason denies and surfaces the reason."""
+        with patch(
+            "registry.services.registration_gate.httpx.AsyncClient"
+        ) as mock_client_cls:
+            client = AsyncMock()
+            client.post = AsyncMock(
+                return_value=_mock_response(403, {"reason": "naming violation"})
+            )
+            client.__aenter__ = AsyncMock(return_value=client)
+            client.__aexit__ = AsyncMock(return_value=False)
+            mock_client_cls.return_value = client
+
+            decision = await check_registration_gate(
+                "server", "/register", "register", SAMPLE_PAYLOAD
+            )
+        assert decision.allowed is False
+        assert decision.failure is False
+        assert decision.reason == "naming violation"
+
+    @pytest.mark.asyncio
+    async def test_deny_on_403_without_reason_uses_fallback(self, gate_enabled):
+        """HTTP 403 with an unparseable body falls back to the fixed reason."""
+        with patch(
+            "registry.services.registration_gate.httpx.AsyncClient"
+        ) as mock_client_cls:
+            client = AsyncMock()
+            client.post = AsyncMock(return_value=_mock_response(403, None))
+            client.__aenter__ = AsyncMock(return_value=client)
+            client.__aexit__ = AsyncMock(return_value=False)
+            mock_client_cls.return_value = client
+
+            decision = await check_registration_gate(
+                "server", "/register", "register", SAMPLE_PAYLOAD
+            )
+        assert decision.allowed is False
+        assert decision.failure is False
+        assert decision.reason == GATE_DENIED_FALLBACK_MESSAGE
+
+    @pytest.mark.asyncio
+    async def test_timeout_fails_closed(self, gate_enabled):
+        """A gate timeout blocks the registration as a failure."""
+        with patch(
+            "registry.services.registration_gate.httpx.AsyncClient"
