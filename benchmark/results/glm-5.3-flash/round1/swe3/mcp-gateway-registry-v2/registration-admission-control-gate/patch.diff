+@pytest.mark.unit
+@pytest.mark.services
+class TestGatePayload:
+    """Tests for the outbound gate payload builder."""
+
+    def test_payload_contains_routing_fields(self):
+        body = _build_gate_payload(
+            "server", "/register", "register", SAMPLE_PAYLOAD, "alice", path="/test-server"
+        )
+        assert body["asset_type"] == "server"
+        assert body["endpoint"] == "/register"
+        assert body["action"] == "register"
+        assert body["user"] == "alice"
+        assert body["path"] == "/test-server"
+        assert "payload" in body
+
+    def test_payload_scrubs_credential_keys(self):
+        body = _build_gate_payload(
+            "server", "/register", "register", SAMPLE_PAYLOAD, "alice"
+        )
+        assert "auth_credential" not in body["payload"]
+        assert "auth_credential_encrypted" not in body["payload"]
+
+    def test_payload_scrubs_nested_and_list_entries(self):
+        payload = {
+            "metadata": {"client_secret": "x", "keep": 1},
+            "items": [{"api_key": "y"}, {"ok": True}],
+            "password": "z",
+        }
+        body = _build_gate_payload("agent", "/agents/register", "register", payload, "bob")
+        assert "client_secret" not in body["payload"]["metadata"]
+        assert "api_key" not in body["payload"]["items"][0]
+        assert "password" not in body["payload"]
+        assert body["payload"]["metadata"]["keep"] == 1
+        assert body["payload"]["items"][1] == {"ok": True}
+
+    def test_overwrite_field_included_only_when_provided(self):
+        body = _build_gate_payload(
+            "server", "/internal/register", "update", SAMPLE_PAYLOAD, "sys", overwrite=True
+        )
+        assert body["overwrite"] is True
+        body2 = _build_gate_payload(
+            "server", "/register", "register", SAMPLE_PAYLOAD, "sys"
+        )
+        assert "overwrite" not in body2
