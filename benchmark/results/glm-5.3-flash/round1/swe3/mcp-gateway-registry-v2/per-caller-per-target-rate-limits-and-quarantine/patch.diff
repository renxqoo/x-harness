+    if subject == reserved_group:
+        logger.error("the reserved quarantine anchor is managed by the system")
+        return 1
+    try:
+        client = _create_client(args)
+        try:
+            existing = client.get_rate_limit_membership(membership_id)
+            groups = [g for g in (existing.get("groups") or []) if g != reserved_group]
+        except Exception:
+            groups = []
+        if args.release:
+            if groups:
+                result = client.set_rate_limit_membership(
+                    subject_type, subject, groups
