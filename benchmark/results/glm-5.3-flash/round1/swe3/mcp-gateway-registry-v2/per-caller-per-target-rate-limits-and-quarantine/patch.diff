@@ -0,0 +1,95 @@
+"""Unit tests for the seeding helper and the seeding repository hook (issue #1504).
+
+The reserved quarantine groups must exist without operator action, seeding must
+be idempotent ($setOnInsert semantics), and a store outage at boot must never
+block or fail startup (SRE must-fix from the expert review).
+"""
+
+from unittest.mock import AsyncMock, MagicMock
+
+from registry.rate_limiting.memberships_repository import (
+    MembershipsRepository,
+    QUARANTINE_SEED_IDS,
+)
+
+
+def _repo_with_collection() -> tuple[MembershipsRepository, MagicMock]:
+    """Build a repository whose collection is a MagicMock with an async update_one."""
+    repo = MembershipsRepository()
+    collection = MagicMock()
+    collection.update_one = AsyncMock(return_value=None)
+
+    async def _fake_get_collection():
+        return collection
+
+    repo._get_collection = _fake_get_collection  # type: ignore[assignment]
+    return repo, collection
+
+
+class TestEnsureQuarantineSeeds:
+    """The seeding hook on MembershipsRepository."""
+
+    async def test_seeds_both_anchor_documents(self):
+        """Both reserved groups get an anchor doc keyed by their seed subject type."""
+        repo, collection = _repo_with_collection()
+        await repo.ensure_quarantine_seeds()
+        assert collection.update_one.await_count == 2
+        seeded_ids = [call.args[0]["_id"] for call in collection.update_one.await_args_list]
+        assert sorted(seeded_ids) == sorted(QUARANTINE_SEED_IDS)
+
+    async def test_seeding_is_set_on_insert(self):
+        """Seeding uses $setOnInsert so restarts never clobber operator edits."""
+        repo, collection = _repo_with_collection()
+        await repo.ensure_quarantine_seeds()
+        for call in collection.update_one.await_args_list:
+            update = call.args[1]
+            assert set(update.keys()) == {"$setOnInsert"}
+            assert update["$setOnInsert"]["enabled"] is True
+            # Self-describing: the doc's groups list names its own reserved group.
+            assert update["$setOnInsert"]["groups"] == [update["$setOnInsert"]["subject"]]
+
+    async def test_seeding_invalidates_cache(self):
+        """After seeding, the read cache is dropped (anchors immediately visible)."""
+        repo, _ = _repo_with_collection()
+        repo._cache["user:x"] = (float("inf"), ["dev"])
+        await repo.ensure_quarantine_seeds()
+        assert repo._cache == {}
+
+
+class TestEnsureQuarantineGroupsSeeded:
+    """The auth-server startup helper: best-effort by contract."""
+
+    async def test_store_outage_never_raises(self):
+        """A raising store must not propagate: startup proceeds (SRE must-fix)."""
+        repo = MembershipsRepository()
+
+        async def _boom():
+            raise RuntimeError("db down")
+
+        repo._get_collection = _boom  # type: ignore[assignment]
+        # The repository-level hook itself is allowed to raise; the helper in
+        # auth_server.rate_limiting_config swallows. Replicate its contract here
+        # by asserting the repo raises and the helper's except covers it.
+        try:
+            await repo.ensure_quarantine_seeds()
+            raised = False
+        except RuntimeError:
+            raised = True
+        assert raised is True
+
+        # And the helper swallows it (import inside the function to reuse the
+        # same lazy-import pattern as server.py).
+        from auth_server.rate_limiting_config import ensure_quarantine_groups_seeded
+
+        async def _seed_boom():
+            raise RuntimeError("db down")
+
+        # Patch the repository construction inside the helper via its module.
+        import auth_server.rate_limiting_config as cfg
+
+        original = cfg.MembershipsRepository
+        try:
+            cfg.MembershipsRepository = lambda: repo  # type: ignore[misc]
+            await ensure_quarantine_groups_seeded()  # must NOT raise
+        finally:
+            cfg.MembershipsRepository = original
