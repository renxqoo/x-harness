+async def ensure_quarantine_groups_seeded() -> None:
+    """Best-effort seeding of the reserved quarantine groups (issue #1504).
+
+    Called from the auth-server startup hook on EVERY boot (independent of
+    ``RATE_LIMITING_ENABLED``) so the reserved caller/target quarantine groups
+    pre-exist an operator's first enablement. Never raises: a store outage at
+    boot must not block startup (the next restart retries; the limiter's
+    fail-open policy covers the window in between).
+    """
+    try:
+        # A throwaway repository: the cache is process-local and the collection
+        # handle is a singleton below it, so this stays cheap.
+        await MembershipsRepository().ensure_quarantine_seeds()
+        logger.info("Reserved quarantine groups seeded (if absent)")
+    except Exception as exc:
+        logger.warning(f"quarantine group seeding skipped (will retry next boot): {exc}")
