+def _quarantine_apply_release(
+    args: argparse.Namespace,
+    subject_type: str,
+    reserved_group: str,
+) -> int:
+    """Add or remove a reserved quarantine group on a subject's membership.
+
+    Read-modify-write over the membership API: adding merges the reserved group
+    into the existing groups; releasing removes it and deletes the membership
+    doc when it becomes empty (never for the seed anchors, which are frozen).
+    """
+    subject = args.subject
