new file mode 100644
index 0000000..55d78df
--- /dev/null
+++ b/registry/schemas/oauth_token_models.py
@@ -0,0 +1,60 @@
+"""
+OAuth token storage data models for server-side token reference sessions.
+
+Defines the schema for storing OAuth IdP access/refresh tokens encrypted
+at rest in MongoDB, keyed by an opaque token reference embedded in the
+session cookie (token-reference pattern, issue #399).
+"""
+
+from datetime import UTC, datetime
+
+from pydantic import BaseModel, Field
+
+
+def _utc_now() -> datetime:
+    """Return current UTC datetime (timezone-aware)."""
+    return datetime.now(UTC)
+
+
+class OAuthTokenDocument(BaseModel):
+    """MongoDB document holding one OAuth login's encrypted IdP tokens.
+
+    Stored with _id = token_ref (the opaque reference embedded in the
+    session cookie). TTL index on expires_at auto-deletes expired records.
+    """
+
+    token_ref: str = Field(
+        ...,
+        min_length=8,
+        max_length=128,
+        description="Opaque reference embedded in the session cookie ('tr_' + 32 url-safe bytes)",
+    )
+    username: str = Field(
+        ...,
+        min_length=1,
+        description="Owner of the tokens; retrieval is scoped to this identity",
+    )
+    provider: str | None = Field(
+        default=None,
+        description="OAuth2 provider that issued the tokens (e.g. 'entra', 'keycloak')",
+    )
+    access_token_encrypted: str = Field(
+        ...,
+        description="Fernet-encrypted IdP access token",
+    )
+    refresh_token_encrypted: str | None = Field(
+        default=None,
+        description="Fernet-encrypted IdP refresh token, if the IdP issued one",
+    )
+    expires_in: int | None = Field(
+        default=None,
+        description="Original IdP-reported access token lifetime in seconds",
+    )
+    obtained_at: datetime = Field(
+        default_factory=_utc_now,
+        description="When the tokens were obtained from the IdP",
+    )
+    expires_at: datetime = Field(
+        ...,
+        description="Storage TTL boundary; drives the MongoDB TTL index",
+    )
diff --git a/registry/utils/oauth_token_encryption.py b/registry/utils/oauth_token_encryption.py
new file mode 100644
index 0000000..2e105c2
--- /dev/null
+++ b/registry/utils/oauth_token_encryption.py
@@ -0,0 +1,124 @@
+"""
+OAuth token encryption utilities.
+
+Provides Fernet-based encryption and decryption for OAuth IdP tokens
+(access/refresh) stored server-side in MongoDB. Uses the application
+SECRET_KEY (via PBKDF2 key derivation) for encryption.
+
+Follows the same pattern as credential_encryption.py but uses a
+purpose-specific salt so ciphertexts from one store cannot be replayed
+in another.
+"""
+
+import base64
+import hashlib
+import logging
+
+from cryptography.fernet import Fernet, InvalidToken
+
+logger = logging.getLogger(__name__)
+
+
+# Salt for PBKDF2 key derivation (purpose-specific to avoid key reuse)
+_KEY_DERIVATION_SALT: bytes = b"mcp-gateway-oauth-token-storage"
+
+# PBKDF2 iteration count
+_KEY_DERIVATION_ITERATIONS: int = 100_000
+
+
+def _derive_fernet_key(
+    secret_key: str,
+) -> bytes:
+    """Derive a Fernet-compatible key from the application SECRET_KEY using PBKDF2.
+
+    Args:
+        secret_key: Application SECRET_KEY string.
+
+    Returns:
+        32-byte url-safe base64-encoded key suitable for Fernet.
+    """
+    derived = hashlib.pbkdf2_hmac(
+        "sha256",
+        secret_key.encode(),
+        _KEY_DERIVATION_SALT,
+        _KEY_DERIVATION_ITERATIONS,
+    )
+    return base64.urlsafe_b64encode(derived)
+
+
+def _get_fernet() -> Fernet | None:
+    """Get a Fernet instance derived from the application SECRET_KEY.
+
+    Returns:
+        Fernet instance, or None if SECRET_KEY is not available.
+    """
+    try:
+        import os
+
+        secret_key = os.environ.get("SECRET_KEY")
+    except Exception as e:
+        logger.error(f"Could not load SECRET_KEY from environment: {e}")
+        return None
+
+    if not secret_key:
+        return None
+
+    try:
+        key = _derive_fernet_key(secret_key)
+        return Fernet(key)
+    except Exception as e:
+        logger.error(f"Failed to derive Fernet key from SECRET_KEY: {e}")
+        return None
+
+
+def encrypt_token(
+    token: str,
+) -> str:
+    """Encrypt an OAuth token for server-side storage.
+
+    Args:
+        token: Plaintext token (IdP access token or refresh token).
+
+    Returns:
+        Fernet-encrypted token string (base64-encoded).
+
+    Raises:
+        ValueError: If SECRET_KEY is not configured or encryption fails.
+    """
+    fernet = _get_fernet()
+    if not fernet:
+        raise ValueError(
+            "SECRET_KEY is not configured. Cannot encrypt OAuth tokens. "
+            "Set SECRET_KEY in your environment."
+        )
+
+    encrypted = fernet.encrypt(token.encode())
+    return encrypted.decode()
+
+
+def decrypt_token(
+    encrypted_token: str,
+) -> str | None:
+    """Decrypt an OAuth token from server-side storage.
+
+    Args:
+        encrypted_token: Fernet-encrypted token string.
+
+    Returns:
+        Plaintext token, or None if decryption fails (key mismatch or
+        corrupted ciphertext).
+    """
+    fernet = _get_fernet()
+    if not fernet:
+        logger.error("SECRET_KEY not configured. Cannot decrypt OAuth token.")
+        return None
+
+    try:
+        decrypted = fernet.decrypt(encrypted_token.encode())
+        return decrypted.decode()
+    except InvalidToken:
+        logger.error("Failed to decrypt OAuth token: invalid token (key mismatch or corruption)")
+        return None
+    except Exception as e:
+        logger.error(f"Failed to decrypt OAuth token: {type(e).__name__}")
+        return None
