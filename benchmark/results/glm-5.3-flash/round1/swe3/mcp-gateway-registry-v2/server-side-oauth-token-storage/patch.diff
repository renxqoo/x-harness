diff --git a/tests/auth_server/unit/test_oauth_token_routes.py b/tests/auth_server/unit/test_oauth_token_routes.py
new file mode 100644
index 0000000..f4b3160
--- /dev/null
+++ b/tests/auth_server/unit/test_oauth_token_routes.py
@@ -0,0 +1,352 @@
+"""
+Unit tests for server-side OAuth token storage routes (issue #399).
+
+Covers the GET /oauth2/tokens endpoint authorization matrix, the OAuth2
+callback token_ref wiring, and logout revocation. Uses the auth_server
+conftest auto-mock environment and mocks the repository at the factory
+boundary. SECRET_KEY is pinned before importing auth_server.server so
+session-cookie fixtures sign with a known key.
+"""
+
+import os
+import time
+from datetime import UTC, datetime, timedelta
+from unittest.mock import AsyncMock, MagicMock, patch
+
+import pytest
+
+# Pin SECRET_KEY BEFORE importing auth_server.server so the module-level
+# signer uses a known key (the module generates a random key otherwise).
+_TEST_SECRET_KEY = "unit-test-secret-key-for-issue-399"
+os.environ.setdefault("SECRET_KEY", _TEST_SECRET_KEY)
+
+import auth_server.server as server_module  # noqa: E402
+from itsdangerous import URLSafeTimedSerializer  # noqa: E402
+from registry.schemas.oauth_token_models import OAuthTokenDocument  # noqa: E402
+
+# Mark all tests in this file
+pytestmark = [pytest.mark.unit, pytest.mark.auth]
+
+_signer = URLSafeTimedSerializer(_TEST_SECRET_KEY)
+
+
+def _make_cookie(
+    username: str = "alice",
+    token_ref: str | None = "tr_testref1234567890",
+) -> str:
+    """Build a signed session cookie like the OAuth2 callback sets."""
+    data = {
+        "username": username,
+        "email": f"{username}@example.com",
+        "name": username.title(),
+        "groups": ["users"],
+        "provider": "entra",
+        "auth_method": "oauth2",
+    }
+    if token_ref:
+        data["token_ref"] = token_ref
+    return _signer.dumps(data)
+
+
+def _make_record(
+    token_ref: str = "tr_testref1234567890",
+    username: str = "alice",
+    expired: bool = False,
+) -> OAuthTokenDocument:
+    """Build a stored token record."""
+    return OAuthTokenDocument(
+        token_ref=token_ref,
+        username=username,
+        provider="entra",
+        access_token_encrypted="gAAAAAencrypted-access",
+        refresh_token_encrypted="gAAAAAencrypted-refresh",
+        expires_in=3600,
+        obtained_at=datetime.now(UTC),
+        expires_at=datetime.now(UTC)
+        + (timedelta(seconds=-1) if expired else timedelta(hours=8)),
+    )
+
+
+@pytest.fixture
+def mock_repo():
+    """Mock OAuth token repository."""
+    repo = MagicMock()
+    repo.store_tokens = AsyncMock()
+    repo.get_user_token = AsyncMock(return_value=None)
+    repo.delete_by_ref = AsyncMock()
+    return repo
+
+
+@pytest.fixture
+def client(mock_repo):
+    """TestClient with the OAuth token repository mocked at the factory."""
+    with patch(
+        "registry.repositories.factory.get_oauth_token_repository", return_value=mock_repo
+    ):
+        from fastapi.testclient import TestClient
+
+        yield TestClient(server_module.app)
+
+
+class TestGetStoredOAuthTokens:
+    """Tests for GET /oauth2/tokens."""
+
+    def test_200_returns_tokens_for_owner(self, client, mock_repo):
+        """Owner retrieval returns decrypted tokens with no-store."""
+        # Arrange
+        record = _make_record()
+        mock_repo.get_user_token.return_value = record
+        cookie = _make_cookie()
+
+        with patch(
+            "registry.utils.oauth_token_encryption.decrypt_token",
+            side_effect=lambda enc: "plain-access" if "access" in enc else "plain-refresh",
+        ):
+            # Act
+            response = client.get("/oauth2/tokens", headers={"Cookie": f"mcp_gateway_session={cookie}"})
+
+        # Assert
+        assert response.status_code == 200
+        assert response.headers.get("cache-control") == "no-store"
+        body = response.json()
+        assert body["access_token"] == "plain-access"
+        assert body["refresh_token"] == "plain-refresh"
+        assert body["token_type"] == "Bearer"
+        assert body["provider"] == "entra"
+        assert body["expires_in"] == 3600
+        # Compound predicate used for the lookup
+        args, _ = mock_repo.get_user_token.await_args
+        assert args == ("tr_testref1234567890", "alice")
+
+    def test_401_without_cookie(self, client):
+        """Missing cookie returns 401."""
+        response = client.get("/oauth2/tokens")
+        assert response.status_code == 401
+
+    def test_401_with_invalid_cookie(self, client):
+        """Tampered cookie returns 401."""
+        response = client.get(
+            "/oauth2/tokens", headers={"Cookie": "mcp_gateway_session=tampered.value"}
+        )
+        assert response.status_code == 401
+
+    def test_404_for_legacy_session(self, client, mock_repo):
+        """Cookie without token_ref (pre-#399 session) returns 404, not 5xx."""
+        cookie = _make_cookie(token_ref=None)
+        response = client.get(
+            "/oauth2/tokens", headers={"Cookie": f"mcp_gateway_session={cookie}"}
+        )
+        assert response.status_code == 404
+        mock_repo.get_user_token.assert_not_awaited()
+
+    def test_404_for_unknown_ref(self, client, mock_repo):
+        """Known-shape ref with no stored record returns 404."""
+        mock_repo.get_user_token.return_value = None
+        cookie = _make_cookie(token_ref="tr_unknown12345678")
+        response = client.get(
+            "/oauth2/tokens", headers={"Cookie": f"mcp_gateway_session={cookie}"}
+        )
+        assert response.status_code == 404
+
+    def test_404_for_other_users_record(self, client, mock_repo):
+        """Cross-user lookup is denied via the compound predicate (404, no leak)."""
+        mock_repo.get_user_token.return_value = None  # compound query misses
+        cookie = _make_cookie(username="alice", token_ref="tr_bobsref12345678")
+        response = client.get(
+            "/oauth2/tokens", headers={"Cookie": f"mcp_gateway_session={cookie}"}
+        )
+        assert response.status_code == 404
+        args, _ = mock_repo.get_user_token.await_args
+        assert args == ("tr_bobsref12345678", "alice")
+
+    def test_410_for_expired_record(self, client, mock_repo):
+        """Expired record (TTL lag) returns 410."""
+        mock_repo.get_user_token.return_value = _make_record(expired=True)
+        cookie = _make_cookie()
