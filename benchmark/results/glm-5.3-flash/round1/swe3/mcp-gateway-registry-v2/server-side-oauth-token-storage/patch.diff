+# --- Server-side OAuth token storage helpers (issue #399) ---
+
+
+def _resolve_oauth_token_ttl() -> int:
+    """Resolve the effective TTL (seconds) for server-side stored OAuth tokens.
+
+    OAUTH_TOKEN_STORAGE_TTL_SECONDS=0 derives the TTL from the configured
+    session max-age so records never outlive their sessions. Values are
+    clamped to [300, 86400].
+    """
+    ttl = OAUTH_TOKEN_STORAGE_TTL_SECONDS
+    if ttl <= 0:
+        try:
+            ttl = int(OAUTH2_CONFIG.get("session", {}).get("max_age_seconds", 28800))
+        except Exception:
+            ttl = 28800
+    return max(300, min(86400, ttl))
+
+
+async def _store_oauth_tokens_server_side(
+    token_data: dict[str, any],
+    mapped_user: dict[str, any],
+    provider: str,
+) -> str | None:
+    """Store IdP tokens encrypted in MongoDB and return the token reference.
+
+    Builds an opaque token reference, persists the Fernet-encrypted access
+    and refresh tokens under it, and returns the reference for the session
+    cookie. Returns None (with a warning log) when storage is disabled,
+    unavailable, or fails - login always continues without the reference.
+
+    Logging invariants: never log token material; refs are logged truncated
+    to a 6-char prefix; usernames are hashed.
+    """
