+# TTL (seconds) for server-side stored OAuth tokens.
+# 0 derives the TTL from the session max-age so records never outlive
+# their sessions (recommended). Clamped to [300, 86400].
+#
+# Default: 28800 (8 hours)
+OAUTH_TOKEN_STORAGE_TTL_SECONDS=28800
+
