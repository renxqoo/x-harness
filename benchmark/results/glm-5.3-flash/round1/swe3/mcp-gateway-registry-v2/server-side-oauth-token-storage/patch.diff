+    Reads the inbound session cookie; if it carries a token_ref, deletes the
+    matching record. Never raises - logout must proceed regardless.
+    """
+    try:
+        cookie_header = request.headers.get("Cookie", "")
+        cookie_value = None
+        for cookie in cookie_header.split(";"):
+            cookie = cookie.strip()
+            if cookie.startswith("mcp_gateway_session="):
+                cookie_value = cookie.split("=", 1)[1]
+                break
+        if not cookie_value:
+            return
+
+        data = signer.loads(cookie_value, max_age=28800)
+        token_ref = data.get("token_ref")
+        if not token_ref:
+            return
+
+        from registry.repositories.factory import get_oauth_token_repository
+
+        repo = get_oauth_token_repository()
+        if repo is None:
+            return
+
+        await repo.delete_by_ref(token_ref)
+        logger.info(
+            f"Revoked server-side OAuth tokens on logout: ref {token_ref[:6]} "
+            f"user {hash_username(data.get('username', ''))}"
+        )
+    except Exception as e:
+        logger.warning(f"OAuth token revocation on logout skipped: {type(e).__name__}")
+
+
+@app.get("/oauth2/tokens")
+async def get_stored_oauth_tokens(request: Request):
+    """Return the current user's stored IdP tokens (issue #399).
+
+    Session-cookie authenticated only: a stateless bearer cannot prove
+    ownership of the interactive session that created the record. The
+    record is looked up by the compound (token_ref, username) pair from
+    the cookie, so a record can only be retrieved by its owner.
+
+    The response is sensitive - always sent with Cache-Control: no-store.
+    Intended for on-demand display/copy, never client-side persistence.
+    """
+    cookie_header = request.headers.get("Cookie", "")
+    cookie_value = None
+    for cookie in cookie_header.split(";"):
+        cookie = cookie.strip()
+        if cookie.startswith("mcp_gateway_session="):
+            cookie_value = cookie.split("=", 1)[1]
+            break
+
+    if not cookie_value:
+        raise HTTPException(status_code=401, detail="Authentication required")
+
+    try:
+        data = signer.loads(cookie_value, max_age=28800)
+    except (SignatureExpired, BadSignature):
+        raise HTTPException(status_code=401, detail="Invalid or expired session")
+    except Exception:
+        raise HTTPException(status_code=401, detail="Invalid or expired session")
+
+    username = data.get("username")
+    if not username:
+        raise HTTPException(status_code=401, detail="Invalid or expired session")
+
+    token_ref = data.get("token_ref")
+    if not token_ref:
+        # Legacy session (pre-#399 login) or storage was disabled at login
+        raise HTTPException(
+            status_code=404,
+            detail="No stored tokens for this session. Please re-login to enable token retrieval.",
+        )
+
+    from registry.repositories.factory import get_oauth_token_repository
+    from registry.utils.oauth_token_encryption import decrypt_token
+
+    repo = get_oauth_token_repository()
+    if repo is None:
+        raise HTTPException(
+            status_code=404,
+            detail="No stored tokens for this session. Please re-login to enable token retrieval.",
+        )
+
+    try:
+        record = await repo.get_user_token(token_ref, username)
+    except Exception:
+        logger.error(
+            f"OAuth token retrieval failed for ref {token_ref[:6]} "
+            f"user {hash_username(username)}"
+        )
+        raise HTTPException(status_code=500, detail="Failed to retrieve stored tokens")
+
+    if record is None:
+        raise HTTPException(
+            status_code=404,
+            detail="No stored tokens for this session. Please re-login to enable token retrieval.",
+        )
+
+    access_token = decrypt_token(record.access_token_encrypted)
+    if access_token is None:
+        logger.error(
+            f"OAuth token decryption failed for ref {token_ref[:6]} "
+            f"user {hash_username(username)}"
+        )
+        raise HTTPException(status_code=500, detail="Failed to retrieve stored tokens")
+
+    refresh_token = (
+        decrypt_token(record.refresh_token_encrypted)
+        if record.refresh_token_encrypted
+        else None
+    )
+
+    logger.info(
+        f"OAuth tokens retrieved: ref {token_ref[:6]} user {hash_username(username)}"
+    )
+
+    return JSONResponse(
+        content={
+            "access_token": access_token,
+            "refresh_token": refresh_token,
+            "token_type": "Bearer",
+            "expires_in": record.expires_in,
+            "provider": record.provider,
+            "obtained_at": int(record.obtained_at.timestamp()),
+            "expires_at": int(record.expires_at.timestamp()),
+        },
+        headers={"Cache-Control": "no-store"},
+    )
