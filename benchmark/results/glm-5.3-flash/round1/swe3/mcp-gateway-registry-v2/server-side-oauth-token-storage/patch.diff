diff --git a/registry/repositories/documentdb/oauth_token_repository.py b/registry/repositories/documentdb/oauth_token_repository.py
new file mode 100644
index 0000000..ad1bead
--- /dev/null
+++ b/registry/repositories/documentdb/oauth_token_repository.py
@@ -0,0 +1,147 @@
+"""
+DocumentDB (MongoDB) implementation for OAuth token storage repository.
+
+Stores OAuth IdP access/refresh tokens encrypted at rest, keyed by an
+opaque token reference (token-reference pattern, issue #399). Documents
+are looked up by the compound (token_ref, username) pair so a record can
+only ever be retrieved by the user it belongs to. A TTL index on
+expires_at automatically deletes expired records.
+"""
+
+import logging
+from datetime import UTC, datetime
+
+from motor.motor_asyncio import AsyncIOMotorCollection
+from pymongo import ASCENDING
+
+from ...schemas.oauth_token_models import OAuthTokenDocument
+from ..interfaces import OAuthTokenRepositoryBase
+from .client import get_collection_name, get_documentdb_client
+
+# Configure logging
+logging.basicConfig(
+    level=logging.INFO,
+    format="%(asctime)s,p%(process)s,{%(filename)s:%(lineno)d},%(levelname)s,%(message)s",
+)
+logger = logging.getLogger(__name__)
+
+
+class DocumentDBOAuthTokenRepository(OAuthTokenRepositoryBase):
+    """MongoDB implementation for encrypted OAuth token storage."""
+
+    def __init__(self):
+        self._collection: AsyncIOMotorCollection | None = None
+        self._collection_name = get_collection_name("oauth_tokens")
+        self._indexes_created = False
+
+    async def _get_collection(self) -> AsyncIOMotorCollection:
+        """Get DocumentDB collection, creating indexes on first access."""
+        if self._collection is None:
+            db = await get_documentdb_client()
+            self._collection = db[self._collection_name]
+            await self.ensure_indexes()
+        return self._collection
+
+    async def ensure_indexes(self) -> None:
+        """Create required indexes if not present.
+
+        Creates:
+        - TTL index on expires_at (deletes documents once expires_at passes)
+        - Index on username for operator queries
+        """
+        if self._indexes_created:
+            return
+
+        if self._collection is None:
+            return
+
+        try:
+            # TTL index: auto-delete documents once expires_at has passed.
+            # expireAfterSeconds=0 means "delete at the time stored in the field".
+            await self._collection.create_index(
+                [("expires_at", ASCENDING)],
+                expireAfterSeconds=0,
+                name="ttl_expires_at",
+            )
+
+            # Index for operator queries over a user's stored records
+            await self._collection.create_index(
+                [("username", ASCENDING)],
+                name="idx_username",
+            )
+
+            self._indexes_created = True
+            logger.info(
+                f"Created indexes for {self._collection_name} collection (TTL on expires_at)"
+            )
+        except Exception as e:
+            logger.warning(f"Could not create indexes for {self._collection_name}: {e}")
+
+    async def store_tokens(
+        self,
+        doc: OAuthTokenDocument,
+    ) -> None:
+        """Store or replace an encrypted OAuth token record (upsert).
+
+        Args:
+            doc: The token document. _id = token_ref, so re-storage with
+                the same ref replaces the record.
+        """
+        collection = await self._get_collection()
+
+        await collection.replace_one(
+            {"_id": doc.token_ref},
+            doc.model_dump(mode="json") | {"_id": doc.token_ref},
+            upsert=True,
+        )
+        # Never log token material; log only a short ref prefix
+        logger.debug(f"Stored OAuth token record: {doc.token_ref[:6]}")
+
+    async def get_user_token(
+        self,
+        token_ref: str,
+        username: str,
+    ) -> OAuthTokenDocument | None:
+        """Get the token record for a reference, scoped to its owner.
+
+        The compound (token_ref, username) predicate is the authorization
+        control: a record can only be retrieved by the username stored
+        with it. Expired documents are treated as gone (the MongoDB TTL
+        monitor may lag up to ~60s behind expires_at).
+
+        Args:
+            token_ref: Opaque reference from the session cookie.
+            username: Authenticated username from the session cookie.
+
+        Returns:
+            The token document, or None if not found or expired.
+        """
+        collection = await self._get_collection()
+
+        result = await collection.find_one({"_id": token_ref, "username": username})
+        if not result:
+            return None
+
+        parsed = OAuthTokenDocument.model_validate(result)
+        if parsed.expires_at <= datetime.now(UTC):
+            # TTL monitor has not collected it yet; delete on sight
+            await collection.delete_one({"_id": token_ref})
+            logger.info(f"Expired OAuth token record deleted on read: {token_ref[:6]}")
+            return None
+
+        return parsed
+
+    async def delete_by_ref(
+        self,
+        token_ref: str,
+    ) -> None:
+        """Delete a token record by reference (logout revocation).
+
+        Args:
+            token_ref: Opaque reference from the session cookie.
+        """
+        collection = await self._get_collection()
+
+        result = await collection.delete_one({"_id": token_ref})
+        if result.deleted_count > 0:
+            logger.info(f"Deleted OAuth token record: {token_ref[:6]}")
