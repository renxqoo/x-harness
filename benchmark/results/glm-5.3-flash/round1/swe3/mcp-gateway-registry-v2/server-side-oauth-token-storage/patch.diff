+"""
+Unit tests for OAuth token storage models and repository (issue #399).
+
+Covers OAuthTokenDocument validation and the DocumentDB repository's
+store/retrieve/delete logic with a mocked Motor collection, including
+the compound (token_ref, username) authorization predicate and
+expired-record handling.
+"""
+
+from datetime import UTC, datetime, timedelta
+from unittest.mock import AsyncMock, MagicMock
+
+import pytest
+from pydantic import ValidationError
+
+from registry.schemas.oauth_token_models import OAuthTokenDocument
+
+
+def _make_doc(
+    token_ref: str = "tr_abc123",
+    username: str = "alice",
+    expires_at: datetime | None = None,
+    **overrides,
+) -> OAuthTokenDocument:
+    """Build a valid OAuthTokenDocument for tests."""
+    defaults = dict(
+        token_ref=token_ref,
+        username=username,
+        provider="entra",
+        access_token_encrypted="gAAAAAencrypted-access",
+        refresh_token_encrypted="gAAAAAencrypted-refresh",
+        expires_in=3600,
+        expires_at=expires_at or (datetime.now(UTC) + timedelta(hours=8)),
+    )
+    defaults.update(overrides)
+    return OAuthTokenDocument(**defaults)
+
+
+class TestOAuthTokenDocument:
+    """Tests for the OAuthTokenDocument model."""
+
+    def test_valid_document(self):
+        """Test creating a valid token document."""
+        doc = _make_doc()
+        assert doc.token_ref == "tr_abc123"
+        assert doc.username == "alice"
+        assert doc.provider == "entra"
+        assert doc.access_token_encrypted == "gAAAAAencrypted-access"
+        assert doc.refresh_token_encrypted == "gAAAAAencrypted-refresh"
+        assert doc.obtained_at is not None
+        assert doc.expires_at > doc.obtained_at
+
+    def test_optional_fields_default_to_none(self):
+        """refresh_token, provider, and expires_in are optional."""
+        doc = _make_doc(refresh_token_encrypted=None, provider=None, expires_in=None)
+        assert doc.refresh_token_encrypted is None
+        assert doc.provider is None
+        assert doc.expires_in is None
+
+    def test_default_timestamps_are_utc(self):
+        """obtained_at defaults to a timezone-aware UTC datetime."""
+        doc = _make_doc()
+        assert doc.obtained_at.tzinfo is not None
+
+    def test_requires_token_ref(self):
+        """token_ref is required."""
+        with pytest.raises(ValidationError):
+            OAuthTokenDocument(
+                username="alice",
+                access_token_encrypted="gAAAAAencrypted",
+                expires_at=datetime.now(UTC) + timedelta(hours=1),
+            )
+
+    def test_requires_username(self):
+        """username is required (authorization scoping depends on it)."""
+        with pytest.raises(ValidationError):
+            OAuthTokenDocument(
+                token_ref="tr_abc123",
+                access_token_encrypted="gAAAAAencrypted",
+                expires_at=datetime.now(UTC) + timedelta(hours=1),
+            )
+
+    def test_requires_access_token(self):
+        """access_token_encrypted is required."""
+        with pytest.raises(ValidationError):
+            OAuthTokenDocument(
+                token_ref="tr_abc123",
+                username="alice",
+                expires_at=datetime.now(UTC) + timedelta(hours=1),
+            )
+
+    def test_requires_expires_at(self):
+        """expires_at is required (drives the TTL index)."""
+        with pytest.raises(ValidationError):
+            OAuthTokenDocument(
+                token_ref="tr_abc123",
+                username="alice",
+                access_token_encrypted="gAAAAAencrypted",
+            )
+
+    def test_token_ref_min_length(self):
+        """token_ref must not be trivially short."""
+        with pytest.raises(ValidationError):
+            _make_doc(token_ref="tr_")
+
+    def test_model_dump_json_serializable(self):
+        """model_dump(mode='json') produces a MongoDB-ready dict."""
+        doc = _make_doc()
+        dumped = doc.model_dump(mode="json")
+        assert isinstance(dumped["expires_at"], str)
+        assert isinstance(dumped["obtained_at"], str)
+
+
+class _FakeCollection:
+    """Minimal fake of a Motor collection for repository logic tests."""
+
+    def __init__(self):
+        self.docs: dict[str, dict] = {}
+        self.find_one_calls: list[dict] = []
+        self.deleted: list[dict] = []
+
+    async def replace_one(self, query, doc, upsert=False):
+        self.docs[query["_id"]] = dict(doc)
+        return MagicMock(upserted_id=doc["_id"] if upsert else None)
+
+    async def find_one(self, query):
+        self.find_one_calls.append(dict(query))
+        return self.docs.get(query["_id"])
+
+    async def delete_one(self, query):
+        _id = query["_id"]
+        if _id in self.docs:
+            del self.docs[_id]
+            self.deleted.append(query)
+            return MagicMock(deleted_count=1)
+        return MagicMock(deleted_count=0)
+
+    def create_index_mock(self):
+        return AsyncMock()
+
+
+class TestDocumentDBOAuthTokenRepository:
+    """Tests for DocumentDBOAuthTokenRepository against a fake collection."""
+
+    @pytest.fixture
+    def repo(self):
+        from registry.repositories.documentdb.oauth_token_repository import (
+            DocumentDBOAuthTokenRepository,
+        )
+
+        r = DocumentDBOAuthTokenRepository()
+        fake = _FakeCollection()
+        r._collection = fake
+        r._indexes_created = True  # skip index creation in most tests
+        return r
+
+    @pytest.mark.asyncio
+    async def test_store_and_get_roundtrip(self, repo):
+        """Storing then retrieving with the matching (ref, username) returns the doc."""
+        doc = _make_doc()
+        await repo.store_tokens(doc)
+
+        result = await repo.get_user_token("tr_abc123", "alice")
+        assert result is not None
+        assert result.token_ref == "tr_abc123"
+        assert result.username == "alice"
+        assert result.access_token_encrypted == "gAAAAAencrypted-access"
+
+    @pytest.mark.asyncio
+    async def test_get_uses_compound_predicate(self, repo):
+        """The lookup query includes BOTH _id and username (authorization control)."""
+        await repo.store_tokens(_make_doc())
+        await repo.get_user_token("tr_abc123", "alice")
+
+        query = repo._collection.find_one_calls[-1]
+        assert query == {"_id": "tr_abc123", "username": "alice"}
+
+    @pytest.mark.asyncio
+    async def test_get_scoped_to_owner(self, repo):
+        """A different username gets None even with the correct ref."""
+        await repo.store_tokens(_make_doc(username="bob"))
+        assert await repo.get_user_token("tr_abc123", "alice") is None
+
+    @pytest.mark.asyncio
+    async def test_get_unknown_ref_returns_none(self, repo):
+        """Unknown ref returns None."""
+        assert await repo.get_user_token("tr_missing", "alice") is None
+
+    @pytest.mark.asyncio
+    async def test_expired_record_treated_as_gone_and_deleted(self, repo):
+        """An expired record (TTL monitor lag) returns None and is deleted on sight."""
+        await repo.store_tokens(
+            _make_doc(expires_at=datetime.now(UTC) - timedelta(seconds=1))
+        )
+        assert await repo.get_user_token("tr_abc123", "alice") is None
+        assert "tr_abc123" not in repo._collection.docs
+
+    @pytest.mark.asyncio
+    async def test_upsert_replaces_same_ref(self, repo):
+        """Re-storing the same ref replaces the record."""
+        await repo.store_tokens(_make_doc(access_token_encrypted="first"))
+        await repo.store_tokens(_make_doc(access_token_encrypted="second"))
+
+        result = await repo.get_user_token("tr_abc123", "alice")
+        assert result.access_token_encrypted == "second"
+
+    @pytest.mark.asyncio
+    async def test_delete_by_ref(self, repo):
+        """delete_by_ref removes the record."""
+        await repo.store_tokens(_make_doc())
+        await repo.delete_by_ref("tr_abc123")
+        assert await repo.get_user_token("tr_abc123", "alice") is None
+
+    @pytest.mark.asyncio
+    async def test_delete_unknown_ref_is_noop(self, repo):
+        """Deleting a missing ref does not raise."""
+        await repo.delete_by_ref("tr_missing")
+
+    @pytest.mark.asyncio
+    async def test_ensure_indexes_creates_ttl(self, repo):
+        """ensure_indexes creates the TTL index on expires_at."""
+        from registry.repositories.documentdb.oauth_token_repository import (
+            DocumentDBOAuthTokenRepository,
+        )
+
+        fresh = DocumentDBOAuthTokenRepository()
+        fake = _FakeCollection()
+        fresh._collection = fake
+        fresh._collection.create_index = AsyncMock()
+
+        await fresh.ensure_indexes()
+
+        assert fresh._collection.create_index.await_count == 2
+        args, kwargs = fresh._collection.create_index.await_args_list[0]
+        assert args[0] == [("expires_at", 1)]
+        assert kwargs["expireAfterSeconds"] == 0
+        assert kwargs["name"] == "ttl_expires_at"
