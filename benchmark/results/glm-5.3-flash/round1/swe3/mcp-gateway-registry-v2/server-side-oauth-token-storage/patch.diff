+"""
+Unit tests for registry.utils.oauth_token_encryption.
+
+Validates Fernet-based encryption/decryption of server-side stored OAuth
+tokens (issue #399): roundtrip behavior, at-rest guarantees, key
+separation from other derived keys, and failure handling.
+"""
+
+import base64
+from unittest.mock import patch
+
+import pytest
+from cryptography.fernet import Fernet
+
+from registry.utils.credential_encryption import _derive_fernet_key as _derive_credential_key
+from registry.utils.oauth_token_encryption import (
+    _derive_fernet_key,
+    decrypt_token,
+    encrypt_token,
+)
+
+
+class TestDeriveFernetKey:
+    """Tests for _derive_fernet_key."""
+
+    def test_derive_fernet_key_produces_valid_key(self):
+        """Verifies _derive_fernet_key returns a 44-byte base64-encoded key."""
+        # Arrange
+        secret = "test-secret-key-for-derivation"
+
+        # Act
+        key = _derive_fernet_key(secret)
+
+        # Assert
+        assert isinstance(key, bytes)
+        assert len(key) == 44
+        decoded = base64.urlsafe_b64decode(key)
+        assert len(decoded) == 32
+
+    def test_derive_fernet_key_deterministic(self):
+        """Same secret must always produce the same key."""
+        key_a = _derive_fernet_key("reproducible-secret")
+        key_b = _derive_fernet_key("reproducible-secret")
+        assert key_a == key_b
+
+    def test_derive_fernet_key_different_secrets_produce_different_keys(self):
+        """Different secrets must produce different keys."""
+        assert _derive_fernet_key("secret-one") != _derive_fernet_key("secret-two")
+
+    def test_key_is_purpose_separated_from_credential_encryption(self):
+        """The OAuth token store key must differ from the credential store key.
+
+        Issue #399 uses a purpose-specific salt so ciphertexts cannot be
+        replayed across stores.
+        """
+        secret = "shared-secret"
+        assert _derive_fernet_key(secret) != _derive_credential_key(secret)
+
+
+class TestEncryptDecryptRoundtrip:
+    """Tests for encrypt_token and decrypt_token working together."""
+
+    @patch("registry.utils.oauth_token_encryption._get_fernet")
+    def test_encrypt_decrypt_roundtrip(self, mock_get_fernet):
+        """Encrypting then decrypting returns the original token."""
+        # Arrange
+        mock_get_fernet.return_value = Fernet(Fernet.generate_key())
+        token = "eyJhbGciOiJSUzI1NiIsImtpZCI6Ik1yaUxhIn0.very-long-jwt-payload.signature"
+
+        # Act
+        encrypted = encrypt_token(token)
+        decrypted = decrypt_token(encrypted)
+
+        # Assert
+        assert decrypted == token
+
+    @patch("registry.utils.oauth_token_encryption._get_fernet")
+    def test_roundtrip_with_refresh_token_and_unicode(self, mock_get_fernet):
+        """Roundtrip handles unicode and arbitrary token shapes."""
+        mock_get_fernet.return_value = Fernet(Fernet.generate_key())
+        for token in ["refresh-token-abc123", "tökën-with-ünicode", "x" * 5000]:
+            encrypted = encrypt_token(token)
+            assert decrypt_token(encrypted) == token
+
+    def test_encrypt_decrypt_roundtrip_with_real_key(self):
+        """End-to-end roundtrip using the real key derivation path."""
+        with patch.dict("os.environ", {"SECRET_KEY": "roundtrip-secret"}):
+            encrypted = encrypt_token("access-token-xyz")
+            assert decrypt_token(encrypted) == "access-token-xyz"
+
+
+class TestEncryptionAtRest:
+    """Tests guaranteeing tokens are not stored in plaintext."""
+
+    def test_ciphertext_is_not_plaintext(self):
+        """The stored (encrypted) value must not contain the token."""
+        with patch.dict("os.environ", {"SECRET_KEY": "at-rest-secret"}):
+            token = "PLAINTEXT_SECRET_ACCESS_TOKEN_12345"
+            encrypted = encrypt_token(token)
+            assert token not in encrypted
+            assert encrypted != token
+
+    def test_encryption_is_non_deterministic(self):
+        """Fernet includes a random nonce; same input yields different ciphertexts."""
+        with patch.dict("os.environ", {"SECRET_KEY": "nonce-secret"}):
+            token = "same-input-token"
+            encrypted_a = encrypt_token(token)
+            encrypted_b = encrypt_token(token)
+            assert encrypted_a != encrypted_b
+            # Both decrypt to the same plaintext
+            assert decrypt_token(encrypted_a) == decrypt_token(encrypted_b) == token
+
+    def test_wrong_key_fails_to_decrypt(self):
+        """A ciphertext encrypted under one key must not decrypt under another."""
+        with patch.dict("os.environ", {"SECRET_KEY": "key-one"}):
+            encrypted = encrypt_token("secret-token")
+        with patch.dict("os.environ", {"SECRET_KEY": "key-two"}):
+            assert decrypt_token(encrypted) is None
+
+
+class TestFailureHandling:
+    """Tests for missing-key and corrupted-input paths."""
+
+    def test_encrypt_without_secret_key_raises(self):
+        """encrypt_token raises ValueError when SECRET_KEY is not configured."""
+        with patch.dict("os.environ", {}, clear=True):
+            with pytest.raises(ValueError):
+                encrypt_token("some-token")
+
+    def test_decrypt_without_secret_key_returns_none(self):
+        """decrypt_token returns None (does not raise) when SECRET_KEY is missing."""
+        with patch.dict("os.environ", {}, clear=True):
+            assert decrypt_token("gAAAAA-not-a-real-token") is None
+
+    def test_decrypt_corrupted_ciphertext_returns_none(self):
+        """decrypt_token returns None on corrupted input instead of raising."""
+        with patch.dict("os.environ", {"SECRET_KEY": "corruption-secret"}):
+            assert decrypt_token("not-a-valid-fernet-token") is None
+            assert decrypt_token("") is None
