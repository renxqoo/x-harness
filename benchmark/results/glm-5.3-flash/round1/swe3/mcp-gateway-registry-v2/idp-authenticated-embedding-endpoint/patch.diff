diff --git a/tests/unit/embeddings/test_idp_token_manager.py b/tests/unit/embeddings/test_idp_token_manager.py
new file mode 100644
index 0000000..a3ed627
--- /dev/null
+++ b/tests/unit/embeddings/test_idp_token_manager.py
@@ -0,0 +1,311 @@
+"""Unit tests for the embeddings IdP token manager.
+
+Covers the OAuth2 client-credentials flow, caching with refresh buffer,
+thread-safety (single-flight refresh), error handling, secret hygiene, the
+LiteLLMClient per-call bearer injection, and the Settings fail-fast validation
+described in lld.md.
+"""
+
+import logging
+import threading
+from datetime import UTC, datetime, timedelta
+from unittest.mock import MagicMock, patch
+
+import httpx
+import numpy as np
+import pytest
+
+from registry.embeddings.client import LiteLLMClient, create_embeddings_client
+from registry.embeddings.idp_token_manager import (
+    DEFAULT_EXPIRES_IN_SECONDS,
+    EmbeddingsIdPTokenError,
+    EmbeddingsIdPTokenManager,
+    create_idp_token_manager,
+)
+
+
+# =============================================================================
+# FIXTURES
+# =============================================================================
+
+
+@pytest.fixture
+def idp_settings(monkeypatch):
+    """Base settings for IdP-enabled embeddings configuration.
+
+    SECRET_KEY and AUTH_SERVER_NGINX_MARKER_SECRET are set by tests/conftest.py
+    before Settings is imported, so only the IdP fields are needed here.
+    """
+    monkeypatch.setenv("EMBEDDINGS_IDP_ENABLED", "true")
+    monkeypatch.setenv("EMBEDDINGS_IDP_TOKEN_URL", "https://idp.example.com/oauth2/token")
+    monkeypatch.setenv("EMBEDDINGS_IDP_CLIENT_ID", "embeddings-client")
+    monkeypatch.setenv("EMBEDDINGS_IDP_CLIENT_SECRET", "super-secret-value")
+    monkeypatch.setenv("EMBEDDINGS_IDP_SCOPE", "embeddings.read")
+    monkeypatch.setenv("EMBEDDINGS_IDP_REFRESH_BUFFER_SECONDS", "60")
+
+
+def _make_manager(**overrides) -> EmbeddingsIdPTokenManager:
+    """Build a manager with a mocked HTTP client for testing."""
+    manager = EmbeddingsIdPTokenManager(
+        token_url="https://idp.example.com/oauth2/token",
+        client_id="embeddings-client",
+        client_secret="super-secret-value",
+        scope="embeddings.read",
+        **overrides,
+    )
+    manager._http_client = MagicMock(spec=httpx.Client)
+    return manager
+
+
+def _mock_response(status_code=200, payload=None, json_error=False):
+    response = MagicMock()
+    response.status_code = status_code
+    if json_error:
+        response.json.side_effect = ValueError("not json")
+    else:
+        response.json.return_value = payload or {
+            "access_token": "tok-1",
+            "expires_in": 3600,
+        }
+    return response
+
+
+# =============================================================================
+# TESTS: EmbeddingsIdPTokenManager
+# =============================================================================
+
+
+@pytest.mark.unit
+@pytest.mark.embeddings
+class TestIdPTokenManager:
+    def test_first_fetch_posts_client_credentials_grant(self):
+        manager = _make_manager()
+        manager._http_client.post.return_value = _mock_response()
+
+        token = manager.get_token()
+
+        assert token == "tok-1"
+        _, kwargs = manager._http_client.post.call_args
+        assert kwargs["data"]["grant_type"] == "client_credentials"
+        assert kwargs["data"]["client_id"] == "embeddings-client"
+        assert kwargs["data"]["client_secret"] == "super-secret-value"
+        assert kwargs["data"]["scope"] == "embeddings.read"
+
+    def test_cache_hit_within_buffer_does_not_refetch(self):
+        manager = _make_manager()
+        manager._http_client.post.return_value = _mock_response()
+
+        manager.get_token()
+        manager.get_token()
+
+        assert manager._http_client.post.call_count == 1
+
+    def test_buffer_refresh_fetches_new_token(self):
+        manager = _make_manager()
+        manager._http_client.post.return_value = _mock_response()
+        manager.get_token()
+
+        # Simulate the cached token being inside the buffer window.
+        manager._token_expiry = datetime.now(UTC) + timedelta(seconds=1)
+        manager._http_client.post.return_value = _mock_response(
+            payload={"access_token": "tok-2", "expires_in": 3600}
+        )
+
+        assert manager.get_token() == "tok-2"
+        assert manager._http_client.post.call_count == 2
+
+    def test_concurrent_callers_single_flight(self):
+        manager = _make_manager()
+        barrier = threading.Barrier(16)
+
+        def slow_post(*args, **kwargs):
+            barrier.wait()
+            return _mock_response()
+
+        manager._http_client.post.side_effect = slow_post
+
+        tokens = []
+        lock = threading.Lock()
+
+        def fetch():
+            token = manager.get_token()
+            with lock:
+                tokens.append(token)
+
+        threads = [threading.Thread(target=fetch) for _ in range(16)]
+        for t in threads:
+            t.start()
+        for t in threads:
+            t.join()
+
+        assert tokens == ["tok-1"] * 16
+        assert manager._http_client.post.call_count == 1
+
+    def test_http_error_status_raises(self):
+        manager = _make_manager()
+        manager._http_client.post.return_value = _mock_response(status_code=400)
+
+        with pytest.raises(EmbeddingsIdPTokenError) as exc:
+            manager.get_token()
+        assert "400" in str(exc.value)
+        assert "super-secret-value" not in str(exc.value)
+
+    def test_network_error_raises_with_type_only(self):
+        manager = _make_manager()
+        manager._http_client.post.side_effect = httpx.ConnectError("boom")
+
+        with pytest.raises(EmbeddingsIdPTokenError) as exc:
+            manager.get_token()
+        assert "ConnectError" in str(exc.value)
+        assert "super-secret-value" not in str(exc.value)
+
+    def test_non_json_response_raises(self):
+        manager = _make_manager()
+        manager._http_client.post.return_value = _mock_response(json_error=True)
+
+        with pytest.raises(EmbeddingsIdPTokenError, match="non-JSON"):
+            manager.get_token()
+
+    def test_missing_access_token_raises(self):
+        manager = _make_manager()
+        manager._http_client.post.return_value = _mock_response(payload={})
+
+        with pytest.raises(EmbeddingsIdPTokenError, match="access_token"):
+            manager.get_token()
+
+    def test_missing_expires_in_defaults_with_warning(self, caplog):
+        manager = _make_manager()
+        manager._http_client.post.return_value = _mock_response(
+            payload={"access_token": "tok-1"}
+        )
+
+        with caplog.at_level(logging.WARNING):
+            token = manager.get_token()
+
+        assert token == "tok-1"
+        assert manager._token_expiry - datetime.now(UTC) > timedelta(
+            seconds=DEFAULT_EXPIRES_IN_SECONDS - 5
+        )
+        assert any("expires_in" in record.message for record in caplog.records)
+
+    def test_clear_token_forces_refetch(self):
+        manager = _make_manager()
+        manager._http_client.post.return_value = _mock_response()
+        manager.get_token()
+
+        manager.clear_token()
+        manager.get_token()
+
+        assert manager._http_client.post.call_count == 2
+
+    def test_no_secret_in_logs_on_failure(self, caplog):
+        manager = _make_manager()
+        manager._http_client.post.side_effect = httpx.ConnectError("boom")
+
+        with caplog.at_level(logging.DEBUG):
+            with pytest.raises(EmbeddingsIdPTokenError):
+                manager.get_token()
+
+        for record in caplog.records:
+            assert "super-secret-value" not in record.getMessage()
+            assert "tok-" not in record.getMessage()
+
+
+# =============================================================================
+# TESTS: LiteLLMClient injection
+# =============================================================================
+
+
+@pytest.mark.unit
+@pytest.mark.embeddings
+class TestLiteLLMClientIdPInjection:
+    def _run_encode(self, client, capture):
+        def fake_embedding(**kwargs):
+            capture.update(kwargs)
+            return {"data": [{"embedding": [0.1, 0.2], "index": 0}]}
+
+        with patch("litellm.embedding", side_effect=fake_embedding):
+            return client.encode(["hello"])
+
+    def test_idp_mode_injects_bearer_per_call(self):
+        manager = _make_manager()
+        manager._http_client.post.return_value = _mock_response()
+        client = LiteLLMClient(
+            model_name="openai/text-embedding-3-small",
+            api_base="https://embed.example.com",
+            idp_token_manager=manager,
+        )
+        capture: dict = {}
+        self._run_encode(client, capture)
+
+        assert capture["api_key"] == "tok-1"
+        assert "input" in capture and "model" in capture
+
+    def test_static_mode_has_no_api_key_kwarg(self):
+        client = LiteLLMClient(model_name="openai/text-embedding-3-small")
+        capture: dict = {}
+        self._run_encode(client, capture)
+
+        assert "api_key" not in capture
+
+    def test_idp_mode_skips_env_push(self):
+        manager = _make_manager()
+        with patch.dict("os.environ", {}, clear=False):
+            LiteLLMClient(
+                model_name="openai/text-embedding-3-small",
+                api_key="STATIC",
+                idp_token_manager=manager,
+            )
+            import os
+
+            assert os.environ.get("OPENAI_API_KEY") != "STATIC"
+
+    def test_static_mode_still_pushes_env(self):
+        import os
+
+        client = LiteLLMClient(
+            model_name="openai/text-embedding-3-small", api_key="STATIC"
+        )
+        assert os.environ.get("OPENAI_API_KEY") == "STATIC"
+        client._set_api_key_env()  # idempotent; guard is at construction
+
+    def test_factory_passthrough(self):
+        manager = _make_manager()
+        client = create_embeddings_client(
+            provider="litellm",
+            model_name="openai/text-embedding-3-small",
+            idp_token_manager=manager,
+        )
+        assert client.idp_token_manager is manager
+
+
+# =============================================================================
+# TESTS: create_idp_token_manager factory
+# =============================================================================
+
+
+@pytest.mark.unit
+@pytest.mark.embeddings
+class TestCreateIdPTokenManager:
+    def _settings(self, idp_enabled, **field_overrides):
+        settings = MagicMock()
