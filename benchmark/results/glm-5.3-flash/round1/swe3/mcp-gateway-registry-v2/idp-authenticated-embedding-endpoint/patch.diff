index 0000000..a83e55b
--- /dev/null
+++ b/registry/embeddings/idp_token_manager.py
@@ -0,0 +1,228 @@
+"""OAuth2 client-credentials token manager for IdP-gated embedding endpoints.
+
+Some enterprise embedding endpoints are OpenAI-compatible on the wire but are gated by a
+short-lived access token (typically a ~60 minute JWT) obtained from an identity provider
+using the OAuth2 client-credentials grant. This module provides a thread-safe token
+manager that fetches, caches, and refreshes that bearer token, plus a factory that builds
+the manager from registry settings.
+
+Mirrors the token-manager pattern used for federation auth
+(``registry.services.federation.federation_auth.FederationAuthManager``): threading.Lock
+around the cache check + refresh, an expiry buffer so tokens are refreshed before they
+actually expire, and error messages that never contain the client secret or the token.
+
+Opt-in: when EMBEDDINGS_IDP_ENABLED is false (the default), ``create_idp_token_manager``
+returns None and the embeddings path behaves exactly as before.
+"""
+
+import logging
+import threading
+from datetime import UTC, datetime, timedelta
+
+import httpx
+
+logger = logging.getLogger(__name__)
+
+# Refresh the cached token this many seconds before it actually expires. Mirrors
+# TOKEN_REFRESH_BUFFER_SECONDS in federation_auth.py.
+DEFAULT_REFRESH_BUFFER_SECONDS: int = 60
+
+# Timeout for token endpoint HTTP calls. Mirrors DEFAULT_TOKEN_TIMEOUT_SECONDS in
+# federation_auth.py.
+DEFAULT_TOKEN_TIMEOUT_SECONDS: float = 30.0
+
+# Assumed lifetime (seconds) when the IdP omits expires_in. Mirrors federation_auth.py;
+# a warning is logged because assuming a lifetime for a short-lived token risks caching
+# past the real expiry.
+DEFAULT_EXPIRES_IN_SECONDS: int = 3600
+
+
+class EmbeddingsIdPTokenError(RuntimeError):
+    """The embeddings IdP token endpoint failed (network, non-2xx, unparseable).
+
+    Error messages intentionally contain only the HTTP status or the exception type
+    name: never the request body, the client secret, or the bearer token.
+    """
+
+
+class EmbeddingsIdPTokenManager:
+    """Thread-safe OAuth2 client-credentials token cache for embeddings calls.
+
+    Fetches a bearer token from an OAuth2 token endpoint, caches it with its expiry,
+    and refreshes it automatically once it is within the refresh buffer of expiry.
+    All access is serialized through a lock so concurrent callers never stampede the
+    token endpoint: the loser of the race re-checks the cache after acquiring the lock
+    and finds the fresh token.
+
+    Unlike the federation manager, ``get_token`` raises on failure instead of returning
+    None: a None bearer would silently degrade the embedding call to an unauthenticated
+    request.
+    """
+
+    def __init__(
+        self,
+        token_url: str,
+        client_id: str,
+        client_secret: str,
+        scope: str | None = None,
+        refresh_buffer_seconds: int = DEFAULT_REFRESH_BUFFER_SECONDS,
+        timeout_seconds: float = DEFAULT_TOKEN_TIMEOUT_SECONDS,
+    ):
+        """Initialize the token manager.
+
+        Args:
+            token_url: OAuth2 token endpoint URL (validated at startup).
+            client_id: OAuth2 client id.
+            client_secret: OAuth2 client secret. Never logged.
+            scope: Optional space-separated scope string sent with the grant.
+            refresh_buffer_seconds: Refresh the token this many seconds before expiry.
+            timeout_seconds: HTTP timeout for token endpoint calls.
+        """
+        self._token_url = token_url
+        self._client_id = client_id
+        self._client_secret = client_secret
+        self._scope = scope
+        self._refresh_buffer_seconds = refresh_buffer_seconds
+        self._token_lock = threading.Lock()
+        self._access_token: str | None = None
+        self._token_expiry: datetime | None = None
+        self._http_client = httpx.Client(timeout=timeout_seconds)
+
+    def get_token(self) -> str:
+        """Return a cached bearer token, refreshing it if within the buffer window.
+
+        Returns:
+            A valid (not yet within-buffer-of-expiry) access token.
+
+        Raises:
+            EmbeddingsIdPTokenError: If the token endpoint is unreachable, returns a
+                non-2xx or non-JSON response, or omits access_token.
+        """
+        with self._token_lock:
+            if self._is_token_valid():
+                logger.debug("Using cached embeddings IdP access token")
+                return self._access_token
+            logger.info("Requesting new access token for embeddings IdP")
+            return self._refresh_token()
+
+    def clear_token(self) -> None:
+        """Clear the cached token, forcing a refresh on the next call."""
+        with self._token_lock:
+            self._access_token = None
+            self._token_expiry = None
+
+    def _is_token_valid(self) -> bool:
+        """Return True only if a cached token exists and is past the refresh buffer."""
+        if not self._access_token or not self._token_expiry:
+            return False
+        buffered = self._token_expiry - timedelta(seconds=self._refresh_buffer_seconds)
+        return datetime.now(UTC) < buffered
+
+    def _refresh_token(self) -> str:
+        """Request a new access token via the client-credentials grant.
+
+        Returns:
+            The fresh access token.
+
+        Raises:
+            EmbeddingsIdPTokenError: On network failure, non-2xx status, non-JSON body,
+                or a missing access_token field.
+        """
+        data = {
+            "grant_type": "client_credentials",
+            "client_id": self._client_id,
+            "client_secret": self._client_secret,
+        }
+        if self._scope:
+            data["scope"] = self._scope
+
+        logger.debug("Requesting embeddings IdP token from %s", self._token_url)
+
+        try:
+            response = self._http_client.post(
+                self._token_url,
+                data=data,
+                headers={
+                    "Content-Type": "application/x-www-form-urlencoded",
+                    "Accept": "application/json",
+                },
+            )
+        except httpx.HTTPError as exc:
+            # Log only the exception type: the error may embed the URL and we must
+            # never leak credentials through logs.
+            logger.error("Embeddings IdP token request failed: %s", type(exc).__name__)
+            raise EmbeddingsIdPTokenError(
+                f"embeddings IdP token endpoint unreachable: {type(exc).__name__}"
+            ) from exc
+
+        if response.status_code >= 400:
+            logger.error(
+                "Embeddings IdP token request rejected with HTTP %s",
+                response.status_code,
+            )
+            raise EmbeddingsIdPTokenError(
+                f"embeddings IdP token request failed with HTTP {response.status_code}"
+            )
+
+        try:
+            payload = response.json()
+        except ValueError as exc:
+            logger.error("Embeddings IdP token endpoint returned non-JSON response")
+            raise EmbeddingsIdPTokenError(
+                "embeddings IdP token endpoint returned a non-JSON response"
+            ) from exc
+
+        token = payload.get("access_token")
+        if not token:
+            logger.error("Embeddings IdP token response missing access_token field")
+            raise EmbeddingsIdPTokenError(
+                "embeddings IdP token response missing access_token"
+            )
+
+        expires_in = payload.get("expires_in")
+        if expires_in is None:
+            logger.warning(
+                "Embeddings IdP token response omitted expires_in; assuming %ss",
+                DEFAULT_EXPIRES_IN_SECONDS,
+            )
+            expires_in = DEFAULT_EXPIRES_IN_SECONDS
+
+        self._access_token = token
+        self._token_expiry = datetime.now(UTC) + timedelta(seconds=int(expires_in))
+        logger.info(
+            "Successfully obtained embeddings IdP access token (expires in %ss)",
+            expires_in,
+        )
+        return self._access_token
+
+    def __del__(self):
+        """Close the HTTP client on deletion."""
+        if hasattr(self, "_http_client"):
+            self._http_client.close()
+
+
+def create_idp_token_manager(settings) -> EmbeddingsIdPTokenManager | None:
+    """Build an IdP token manager from settings, or None when the feature is disabled.
+
+    Opt-in contract: with EMBEDDINGS_IDP_ENABLED unset/false this returns None and no
+    IdP machinery is constructed. Required settings are validated at startup
+    (Settings._validate_embeddings_idp_config), so a fully-enabled configuration is
+    guaranteed to have all fields present by the time this factory runs.
+
+    Args:
+        settings: The registry Settings instance.
+
+    Returns:
+        An EmbeddingsIdPTokenManager, or None when IdP mode is disabled.
+    """
+    if not settings.embeddings_idp_enabled:
+        return None
+
+    secret = settings.embeddings_idp_client_secret
+    return EmbeddingsIdPTokenManager(
+        token_url=settings.embeddings_idp_token_url,
+        client_id=settings.embeddings_idp_client_id,
+        client_secret=secret.get_secret_value() if secret else "",
+        scope=settings.embeddings_idp_scope,
+        refresh_buffer_seconds=settings.embeddings_idp_refresh_buffer_seconds,
+    )
