+@internal_router.post("/logout-url", response_model=InternalLogoutUrlResponse)
+async def internal_logout_url(
+    body: InternalLogoutUrlRequest,
+    request: Request,
+    caller: str = Depends(validate_internal_auth),
+):
+    """Build the IdP logout URL for the given provider (internal hop).
+
+    Called by the registry during RP-initiated logout so the OIDC id_token_hint
+    is delivered over the internal network instead of a browser-facing redirect
+    URL (issue #1503). The registry 303-redirects the browser straight to the
+    returned IdP URL. Gated by the router-level ``validate_internal_auth``
+    dependency; ``caller`` re-declares it for audit logging (cached per
+    request).
+
+    A provider with no ``logout_url`` configured yields a 200 whose
+    ``logout_url`` is the (absolutized) registry return URL and
+    ``id_token_hint_included`` is False - a success, mirroring the legacy
+    browser-facing endpoint's local-only redirect for that case.
+    """
+    logger.info(f"Internal logout-url call from '{caller}' for provider '{body.provider}'")
+
+    if body.provider not in OAUTH2_CONFIG.get("providers", {}):
+        raise HTTPException(status_code=404, detail=f"Provider {body.provider} not found")
+
+    provider_config = OAUTH2_CONFIG["providers"][body.provider]
+
+    # Same redirect-safety guard as the legacy oauth2_logout: an absolute
+    # redirect_uri outside the deployment's cookie domain is dropped (falls
+    # back to /login-derived default below) rather than erroring, so a bad
+    # value can never reach the IdP through this path either.
+    redirect_uri = body.redirect_uri
+    if redirect_uri:
+        parsed = urlparse(redirect_uri)
+        if parsed.scheme or parsed.netloc:
+            cookie_domain = os.environ.get("SESSION_COOKIE_DOMAIN", "").strip()
+            if not _is_redirect_within_cookie_domain(redirect_uri, cookie_domain, request=request):
+                logger.warning(
+                    f"Blocked unsafe logout redirect_uri for {body.provider}: {redirect_uri}"
+                )
+                redirect_uri = None
+
+    if not provider_config.get("logout_url"):
+        # Provider has no IdP logout endpoint: hand back the registry return
+        # URL so the caller finishes the local-only logout as the legacy
+        # endpoint would.
+        fallback_url = redirect_uri or OAUTH2_CONFIG.get("registry", {}).get(
+            "success_redirect", "/login"
+        )
+        if not fallback_url.startswith("http"):
+            registry_base = os.environ.get("REGISTRY_URL")
+            if not registry_base:
+                referer = request.headers.get("referer", "")
+                if referer:
+                    parsed = urlparse(referer)
+                    registry_base = f"{parsed.scheme}://{parsed.netloc}"
+                else:
+                    registry_base = "http://localhost"
+            fallback_url = f"{registry_base.rstrip('/')}{fallback_url}"
+        return InternalLogoutUrlResponse(logout_url=fallback_url, id_token_hint_included=False)
+
+    full_redirect_uri = redirect_uri or "/login"
+    if not full_redirect_uri.startswith("http"):
+        registry_base = os.environ.get("REGISTRY_URL")
+        if not registry_base:
+            referer = request.headers.get("referer", "")
+            if referer:
+                parsed = urlparse(referer)
+                registry_base = f"{parsed.scheme}://{parsed.netloc}"
+            else:
+                registry_base = "http://localhost"
+        full_redirect_uri = f"{registry_base.rstrip('/')}{full_redirect_uri}"
+
+    logout_redirect_url, id_token_hint_included = _build_provider_logout_url(
+        body.provider, provider_config, body.id_token, full_redirect_uri
+    )
+    return InternalLogoutUrlResponse(
+        logout_url=logout_redirect_url, id_token_hint_included=id_token_hint_included
+    )
