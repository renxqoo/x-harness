+class InternalLogoutUrlRequest(BaseModel):
+    """Body for POST /internal/logout-url (issue #1503).
+
+    The registry sends the OIDC id_token over the internal network so the hint
+    never has to traverse a browser-facing URL (which WAFs reject by size and
