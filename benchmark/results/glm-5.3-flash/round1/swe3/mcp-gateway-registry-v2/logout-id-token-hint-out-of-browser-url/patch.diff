+async def _fetch_logout_url_via_internal(
+    provider: str,
+    id_token: str | None,
+    redirect_uri: str,
+) -> tuple[str, bool] | None:
+    """Fetch the IdP logout URL from the auth server over the internal hop.
+
+    Called during OAuth2 logout so the OIDC id_token_hint travels over the
+    internal network (POST /internal/logout-url, internal-JWT gated) instead
+    of a browser-facing redirect URL, where WAFs reject the large query string
+    and the JWT leaks into browser history and proxy logs (issue #1503).
+
+    Returns ``(logout_url, id_token_hint_included)`` on success, or None when
+    the internal path is unavailable (caller falls back to the legacy
+    browser-facing redirect). Never raises.
+    """
+    try:
+        from .internal import generate_internal_token
+
+        token = generate_internal_token(
+            subject="registry-service",
+            purpose="logout-url",
+        )
+        async with httpx.AsyncClient() as client:
+            response = await client.post(
+                f"{settings.auth_server_url}/internal/logout-url",
+                json={
+                    "provider": provider,
+                    "id_token": id_token,
+                    "redirect_uri": redirect_uri,
+                },
+                headers={"Authorization": f"Bearer {token}"},
+                timeout=5.0,
+            )
+
+        if response.status_code != 200:
+            logger.warning(
+                "Internal logout-url fetch failed: HTTP %s (falling back to legacy redirect)",
+                response.status_code,
+            )
+            logout_internal_hint_fallback.inc()
+            return None
+
+        data = response.json()
+        return data["logout_url"], bool(data.get("id_token_hint_included", False))
+    except Exception as e:
+        logger.warning(
+            f"Internal logout-url fetch failed: {type(e).__name__} (falling back to legacy redirect)"
+        )
+        logout_internal_hint_fallback.inc()
+        return None
+
