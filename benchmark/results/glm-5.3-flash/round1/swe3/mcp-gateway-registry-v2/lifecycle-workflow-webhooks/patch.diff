@@ -0,0 +1,67 @@
+"""Unit tests for the mandated initial registration status (Issue #1330)."""
+
+import pytest
+
+from registry.api.server_routes import (
+    _apply_mandated_initial_status,
+    _validate_lifecycle_status_or_400,
+)
+from fastapi import HTTPException
+
+
+class TestValidateLifecycleStatusOr400:
+    """Tests for the shared status validator wrapper."""
+
+    def test_none_passes_through(self):
+        assert _validate_lifecycle_status_or_400(None) is None
+
+    def test_valid_status_normalized(self):
+        assert _validate_lifecycle_status_or_400("DRAFT") == "draft"
+
+    def test_invalid_status_raises_400(self):
+        with pytest.raises(HTTPException) as exc:
+            _validate_lifecycle_status_or_400("bogus")
+        assert exc.value.status_code == 400
+        assert "draft" in str(exc.value.detail)
+
+
+class TestApplyMandatedInitialStatus:
+    """Tests for _apply_mandated_initial_status (Issue #1330)."""
+
+    def test_no_mandate_passthrough(self, monkeypatch):
+        monkeypatch.setattr(
+            "registry.api.server_routes.settings.registration_mandated_initial_status", ""
+        )
+        assert _apply_mandated_initial_status(None) is None
+        assert _apply_mandated_initial_status("active") == "active"
+
+    def test_omitted_status_forced_to_mandate(self, monkeypatch):
+        monkeypatch.setattr(
+            "registry.api.server_routes.settings.registration_mandated_initial_status", "draft"
+        )
+        assert _apply_mandated_initial_status(None) == "draft"
+        assert _apply_mandated_initial_status("") == "draft"
+        assert _apply_mandated_initial_status("  ") == "draft"
+
+    def test_matching_explicit_status_accepted(self, monkeypatch):
+        monkeypatch.setattr(
+            "registry.api.server_routes.settings.registration_mandated_initial_status", "draft"
+        )
+        assert _apply_mandated_initial_status("DRAFT") == "draft"
+
+    def test_mismatched_explicit_status_rejected(self, monkeypatch):
+        monkeypatch.setattr(
+            "registry.api.server_routes.settings.registration_mandated_initial_status", "draft"
+        )
+        with pytest.raises(HTTPException) as exc:
+            _apply_mandated_initial_status("active")
+        assert exc.value.status_code == 400
+        assert "draft" in str(exc.value.detail)
+
+    def test_invalid_mandate_degrades_to_no_mandate(self, monkeypatch):
+        monkeypatch.setattr(
+            "registry.api.server_routes.settings.registration_mandated_initial_status", "chaos"
+        )
+        # Misconfiguration must not block registrations.
+        assert _apply_mandated_initial_status(None) is None
+        assert _apply_mandated_initial_status("active") == "active"
