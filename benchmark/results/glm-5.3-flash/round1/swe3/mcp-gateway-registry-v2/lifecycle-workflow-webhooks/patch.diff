+class TestWebhookSigning:
+    """HMAC-SHA256 body signing (Issue #1330)."""
+
+    @pytest.mark.asyncio
+    async def test_signature_header_present_when_secret_set(self):
+        """X-Webhook-Signature carries sha256=<hex> over the exact body bytes."""
+        import hashlib
+        import hmac as hmac_mod
+        import json
+
+        captured = {}
+
+        async def _capture_post(url, content=None, headers=None):
+            captured["body"] = content
+            captured["headers"] = headers
+            response = MagicMock()
+            response.status_code = 200
+            return response
+
+        mock_client = AsyncMock()
+        mock_client.__aenter__.return_value.post = _capture_post
+        mock_client.__aexit__.return_value = None
+
+        with (
+            patch("registry.services.webhook_service.settings") as mock_settings,
+            patch("registry.services.webhook_service.httpx.AsyncClient", return_value=mock_client),
+        ):
+            mock_settings.registration_webhook_url = "https://hooks.example.com/recv"
+            mock_settings.registration_webhook_auth_token = None
+            mock_settings.registration_webhook_auth_header = "Authorization"
+            mock_settings.registration_webhook_timeout_seconds = 10
+            mock_settings.registration_webhook_signing_secret = "test-secret"
+
+            await send_registration_webhook(
+                event_type="registration",
+                registration_type="server",
+                card_data=SAMPLE_CARD,
+            )
+
+        sig = captured["headers"]["X-Webhook-Signature"]
+        assert sig.startswith("sha256=")
+        expected = hmac_mod.new(
+            b"test-secret", captured["body"], hashlib.sha256
+        ).hexdigest()
+        assert hmac_mod.compare_digest(sig.removeprefix("sha256="), expected)
+        # Body is exactly the canonical JSON serialization that was signed.
+        assert json.loads(captured["body"])["event_type"] == "registration"
