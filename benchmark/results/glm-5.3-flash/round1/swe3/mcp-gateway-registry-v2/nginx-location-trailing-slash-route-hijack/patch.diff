-        location_path = path
+        # Normalize to a leading+trailing slash so the prefix location owns
+        # exactly this server's route subtree: nginx prefix locations match
+        # every URI starting with the location string, so the historical
+        # `location /name` also intercepted sibling namespaces (/apiv2, and
+        # for a server registered at /a: /api, /auth, /about) and 401-ed
+        # unauthenticated browser navigation via the block's auth_request.
+        # Clients are unaffected: /name/mcp, /name/sse, /name/messages still
+        # match the /name/ block.
+        location_path = self._normalize_location_path(path)
         logger.info(f"Creating location block for {location_path} with {transport_type} transport")
 
-        return f"""
+        # Bare-path compatibility for servers registered with
+        # append_mcp_path=False: their MCP clients POST the registered path
+        # itself, and a prefix location /name/ does not match /name. An
+        # exact-match block forwards those to the same auth_server mcp-proxy
+        # hop (the hop tolerates a missing transport segment --
+        # _registered_server_from_proxy_path keys on the first segment alone).
+        # Both blocks are assembled from the same settings fragments so the
+        # auth wiring can never diverge between them. The root path is all
+        # catch-all already: no bare exact block exists (or is valid) there.
+        bare_path = location_path.rstrip("/")
+        bare_block = ""
+        if bare_path:
+            bare_block = f"""
+    location = {{{{ROOT_PATH}}}}{bare_path} {{{transport_settings}{common_settings}
+    }}"""
+
+        return bare_block + f"""
     location {{{{ROOT_PATH}}}}{location_path} {{{transport_settings}{common_settings}
     }}"""
 
diff --git a/tests/unit/core/test_nginx_service.py b/tests/unit/core/test_nginx_service.py
