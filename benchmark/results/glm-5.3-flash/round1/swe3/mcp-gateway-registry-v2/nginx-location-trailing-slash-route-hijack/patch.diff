+    @staticmethod
+    def _normalize_location_path(path: str) -> str:
+        """Normalize a registered server path for an nginx prefix location.
+
+        The generated block must own exactly the server's route subtree, so the
+        location carries a leading AND trailing slash: nginx prefix locations
+        match every URI that starts with the location string, and a bare
+        ``location /name`` would also hijack sibling namespaces such as
+        ``/apiv2`` -- and for a server registered at ``/a``, ``/api`` and
+        ``/auth``. Registration validation (``_SERVER_PATH_RE``) guarantees a
+        slug-only value, so normalization only ever moves or adds slashes; it
+        cannot meet nginx metacharacters.
+
+        Accepts the shapes found in the wild (leading slash missing on some
+        write paths, trailing slash persisted by others) and returns one
+        canonical form: ``/name/``. The root path ``/`` maps to itself.
+        """
+        segments = [seg for seg in path.split("/") if seg]
+        if not segments:
+            return "/"
+        return "/" + "/".join(segments) + "/"
+
     @staticmethod
     def _is_host_resolvable_at_startup(
         hostname: str,
