diff --git a/tests/unit/api/test_config_routes_title.py b/tests/unit/api/test_config_routes_title.py
new file mode 100644
index 0000000..6cad44a
--- /dev/null
+++ b/tests/unit/api/test_config_routes_title.py
@@ -0,0 +1,136 @@
+"""Unit tests for UI_TITLE exposure in the configuration API.
+
+Covers the two must-see surfaces from issue #984:
+- GET /api/config includes the effective ``ui_title``.
+- GET /api/config/full (System Config panel) lists ``ui_title`` and
+  ``effective_ui_title`` in the deployment group, unmasked.
+"""
+
+from unittest.mock import patch
+
+import pytest
+from fastapi.testclient import TestClient
+
+from registry.api import config_routes
+from registry.core.config import Settings
+
+
+# =============================================================================
+# FIXTURES
+# =============================================================================
+
+
+@pytest.fixture
+def client():
+    """TestClient for the config router with auth bypassed."""
+    from registry.main import app
+
+    with TestClient(app) as test_client:
+        with patch("registry.api.config_routes.enhanced_auth", return_value=None):
+            yield test_client
+
+
+@pytest.fixture
+def gateway_settings(monkeypatch, tmp_path):
+    """Settings with UI_TITLE unset, default with-gateway mode."""
+    monkeypatch.delenv("UI_TITLE", raising=False)
+    monkeypatch.delenv("DEPLOYMENT_MODE", raising=False)
+    monkeypatch.chdir(tmp_path)
+    return Settings()
+
+
+@pytest.fixture
+def registry_only_settings(monkeypatch, tmp_path):
+    """Settings with UI_TITLE unset, registry-only mode."""
+    monkeypatch.delenv("UI_TITLE", raising=False)
+    monkeypatch.setenv("DEPLOYMENT_MODE", "registry-only")
+    monkeypatch.chdir(tmp_path)
+    return Settings()
+
+
+@pytest.fixture
+def custom_title_settings(monkeypatch, tmp_path):
+    """Settings with an explicit UI_TITLE override."""
+    monkeypatch.setenv("UI_TITLE", "Acme AI Platform")
+    monkeypatch.setenv("DEPLOYMENT_MODE", "registry-only")
+    monkeypatch.chdir(tmp_path)
+    return Settings()
+
+
+# =============================================================================
+# TESTS: GET /api/config
+# =============================================================================
+
+
+@pytest.mark.unit
+@pytest.mark.api
+class TestConfigEndpointUiTitle:
+    """The public config endpoint exposes the effective UI title."""
+
+    def test_ui_title_key_present(self, client):
+        """The response includes a ui_title key."""
+        response = client.get("/api/config")
+        assert response.status_code == 200
+        assert "ui_title" in response.json()
+
+    def test_ui_title_derived_with_gateway(self, client, gateway_settings):
+        """Unset UI_TITLE in with-gateway mode yields the gateway title."""
+        with patch.object(config_routes, "settings", gateway_settings):
+            response = client.get("/api/config")
+        assert response.status_code == 200
+        assert response.json()["ui_title"] == "AI Gateway & Registry"
+
+    def test_ui_title_derived_registry_only(self, client, registry_only_settings):
+        """Unset UI_TITLE in registry-only mode yields the registry title."""
+        with patch.object(config_routes, "settings", registry_only_settings):
+            response = client.get("/api/config")
+        assert response.status_code == 200
+        assert response.json()["ui_title"] == "AI Registry"
+
+    def test_ui_title_explicit_override(self, client, custom_title_settings):
+        """Explicit UI_TITLE is returned verbatim."""
