+# =============================================================================
+# TEST CLASS: UI Title Configuration
+# =============================================================================
+
+
+@pytest.mark.unit
+@pytest.mark.core
+class TestUiTitleConfiguration:
+    """Test UI_TITLE configuration and deployment-mode-aware derivation."""
+
+    def test_ui_title_default_is_none(self, monkeypatch, tmp_path) -> None:
+        """UI_TITLE unset means ui_title is None."""
+        monkeypatch.delenv("UI_TITLE", raising=False)
+        monkeypatch.delenv("DEPLOYMENT_MODE", raising=False)
+        monkeypatch.chdir(tmp_path)
+
+        settings = Settings()
+
+        assert settings.ui_title is None
+
+    def test_effective_ui_title_default_with_gateway(self, monkeypatch, tmp_path) -> None:
+        """Unset UI_TITLE with the default mode yields the gateway-and-registry title."""
+        monkeypatch.delenv("UI_TITLE", raising=False)
+        monkeypatch.delenv("DEPLOYMENT_MODE", raising=False)
+        monkeypatch.chdir(tmp_path)
+
+        settings = Settings()
+
+        assert settings.effective_ui_title == "AI Gateway & Registry"
+
+    def test_effective_ui_title_registry_only_derived(self, monkeypatch, tmp_path) -> None:
+        """Unset UI_TITLE in registry-only mode yields the registry-only title."""
+        monkeypatch.delenv("UI_TITLE", raising=False)
+        monkeypatch.setenv("DEPLOYMENT_MODE", "registry-only")
+        monkeypatch.chdir(tmp_path)
+
+        settings = Settings()
+
+        assert settings.deployment_mode.value == "registry-only"
+        assert settings.effective_ui_title == "AI Registry"
+
+    def test_effective_ui_title_explicit_override(self, monkeypatch, tmp_path) -> None:
+        """Explicit UI_TITLE wins over the mode-derived default."""
+        monkeypatch.setenv("UI_TITLE", "Acme AI Platform")
+        monkeypatch.setenv("DEPLOYMENT_MODE", "registry-only")
+        monkeypatch.chdir(tmp_path)
+
+        settings = Settings()
+
+        assert settings.ui_title == "Acme AI Platform"
+        assert settings.effective_ui_title == "Acme AI Platform"
+
+    def test_effective_ui_title_blank_string_treated_as_unset(self, monkeypatch, tmp_path) -> None:
+        """Empty (and whitespace-only) UI_TITLE falls back to the derived default."""
+        monkeypatch.setenv("UI_TITLE", "")
+        monkeypatch.setenv("DEPLOYMENT_MODE", "registry-only")
+        monkeypatch.chdir(tmp_path)
+
+        settings = Settings()
+
+        assert settings.effective_ui_title == "AI Registry"
+
+    def test_effective_ui_title_whitespace_only_treated_as_unset(
+        self, monkeypatch, tmp_path
+    ) -> None:
+        """Whitespace-only UI_TITLE falls back to the derived default."""
+        monkeypatch.setenv("UI_TITLE", "   ")
+        monkeypatch.delenv("DEPLOYMENT_MODE", raising=False)
+        monkeypatch.chdir(tmp_path)
+
+        settings = Settings()
+
+        assert settings.effective_ui_title == "AI Gateway & Registry"
+
